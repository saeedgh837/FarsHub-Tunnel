[Unit]
Description=FarsHub Tunnel (Server)
Documentation=file:/etc/farshub/server.toml
After=network-online.target
Wants=network-online.target

# Prevent an infinite restart loop on a permanent error (wrong token, missing cert)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/farshub _exec server
WorkingDirectory=/var/lib/farshub
# Without this, the engine's name shows up in the journal after the exec.
SyslogIdentifier=farshub
Restart=always
RestartSec=3
LimitNOFILE=1048576

# ---- Hardening ----
# Runs as root because the engine tunes system sysctls at startup
# (net.core.*, net.ipv4.tcp_*) and raises RLIMIT_NOFILE.
# ProtectKernelTunables and ProtectSystem=strict would break that - they are
# deliberately not enabled. If the tuning does not matter to you, uncomment
# the lines below:
#   User=farshub
#   Group=farshub
#   ProtectSystem=strict
#   ProtectKernelTunables=yes
#   AmbientCapabilities=CAP_NET_BIND_SERVICE   # only if a port <1024 is needed
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadWritePaths=/var/log/farshub /var/lib/farshub

[Install]
WantedBy=multi-user.target
