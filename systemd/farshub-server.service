[Unit]
Description=FarsHub Tunnel (Server)
Documentation=file:/etc/farshub/server.toml
After=network-online.target
Wants=network-online.target

# جلوگیری از restart loop بی‌نهایت در خطای دائمی (توکن غلط، cert گم‌شده)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/farshub _exec server
WorkingDirectory=/var/lib/farshub
# بدون این، بعد از exec نام موتور اجرا در journal ظاهر می‌شود.
SyslogIdentifier=farshub
Restart=always
RestartSec=3
LimitNOFILE=1048576

# ---- Hardening ----
# با root اجرا می‌شود چون موتور اجرا در استارت‌آپ sysctl سیستم را تیون می‌کند
# (net.core.*, net.ipv4.tcp_*) و RLIMIT_NOFILE را بالا می‌برد.
# ProtectKernelTunables و ProtectSystem=strict این کار را می‌شکنند — عمداً
# فعال نشده‌اند. اگر تیونینگ برایتان مهم نیست، خطوط زیر را کامنت‌برداری کنید:
#   User=farshub
#   Group=farshub
#   ProtectSystem=strict
#   ProtectKernelTunables=yes
#   AmbientCapabilities=CAP_NET_BIND_SERVICE   # فقط اگر پورت <1024 لازم است
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadWritePaths=/var/log/farshub /var/lib/farshub

[Install]
WantedBy=multi-user.target
