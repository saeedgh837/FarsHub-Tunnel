# FarsHub web panel API service.
#
# It listens on 127.0.0.1 and is never directly reachable from the network -
# nginx sits in front of it and the auth_basic lives there.
#
# It runs as the shell-less 'farshub-api' user and, for every task that needs
# root, calls 'sudo farshub <subcommand>' with a fixed argument (the fixed
# list lives in /etc/sudoers.d/farshub-api).
#
# Two hardening settings are deliberately absent here:
#   NoNewPrivileges  → blocks setuid execution, and sudo is setuid.
#   ProtectSystem    → the mount namespace is inherited by root's children
#                      too, so 'sudo farshub apply-config' could not write
#                      /etc/farshub. And against the farshub-api user itself
#                      it adds nothing: ordinary unix permissions do that job.

[Unit]
Description=FarsHub Tunnel - panel API service
Documentation=https://github.com/saeedgh837/FarsHub-Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=farshub-api
Group=farshub-api
ExecStart=/usr/local/bin/farshub-api --host 127.0.0.1 --port 2061
Restart=always
RestartSec=3
SyslogIdentifier=farshub-api
StartLimitIntervalSec=300
StartLimitBurst=10

RuntimeDirectory=farshub-api
RuntimeDirectoryMode=0700
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
