[Unit]
Description=FarsHub Tunnel (Client)
Documentation=file:/etc/farshub/client.toml
After=network-online.target
Wants=network-online.target

# Prevent an infinite restart loop on a permanent error (wrong token, wrong address)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/farshub _exec client
WorkingDirectory=/var/lib/farshub
SyslogIdentifier=farshub
Restart=always
RestartSec=3
LimitNOFILE=1048576

# ---- Hardening ----
# Full explanation in farshub-server.service — the engine tunes system sysctls
# at startup, so ProtectKernelTunables / ProtectSystem=strict are not enabled.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadWritePaths=/var/log/farshub /var/lib/farshub

[Install]
WantedBy=multi-user.target
