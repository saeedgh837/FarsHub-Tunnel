# همه‌ی فایل‌های متنی همیشه با LF چک‌اوت می‌شوند — روی ویندوز هم.
# این خط اختیاری نیست: یک CR در انتهای شبیانگ bin/farshub روی لینوکس
# «bad interpreter: /bin/sh^M» می‌دهد و هیچ‌چیز اجرا نمی‌شود.
* text=auto eol=lf

# موتور اجرا باید byte-identical بماند (MD5 در docs/ORIGIN.md).
# `binary` یعنی گیت هیچ نرمال‌سازی خط‌پایانی رویش انجام نمی‌دهد.
bin/farshub-core binary

# فونت‌ها هم باینری‌اند.
*.woff2 binary
