#!/bin/sh
# ==========================================================================
#  FarsHub Tunnel — CLI
#
#  تنها چیزی که کاربر تایپ می‌کند. موتور اجرا `farshub-core` است (build
#  آپ‌استریم، دست‌نخورده) و این پوسته آن را صدا می‌زند. هدف: نام و پیام‌های
#  FarsHub در همه‌ی خروجی‌های کاربرپسند، بدون هیچ تغییری در باینری.
#
#  POSIX sh — به bash نیاز ندارد.
# ==========================================================================
set -eu

CLI_VERSION='1.0.5'
BRAND='FarsHub Tunnel'
SUPPORT='https://t.me/vpsfa'

CONF_DIR="${FARSHUB_CONF_DIR:-/etc/farshub}"
LIBEXEC="${FARSHUB_LIBEXEC:-/usr/local/libexec/farshub}"
BIN_DIR="${FARSHUB_BIN_DIR:-/usr/local/bin}"
UNIT_DIR="${FARSHUB_UNIT_DIR:-/etc/systemd/system}"
# این دو در configs و یونیت‌های systemd هم آمده‌اند؛ متغیر بودنشان فقط برای
# تست نصب در یک prefix موقت است.
LOG_DIR="${FARSHUB_LOG_DIR:-/var/log/farshub}"
STATE_DIR="${FARSHUB_STATE_DIR:-/var/lib/farshub}"

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

die()  { printf 'farshub: %s\n' "$1" >&2; exit "${2:-1}"; }
say()  { printf '%s\n' "$*"; }

# ------------------------------------------------------------- موتور اجرا --
# ترتیب جست‌وجو: متغیر محیطی، libexec (محل نصب)، کنار همین اسکریپت (مخزن
# باز‌نشده)، و در آخر PATH.
find_core() {
  if [ -n "${FARSHUB_CORE:-}" ]; then
    [ -x "$FARSHUB_CORE" ] || die "FARSHUB_CORE اجرایی نیست: $FARSHUB_CORE"
    printf '%s\n' "$FARSHUB_CORE"; return
  fi
  for c in "$LIBEXEC/farshub-core" "$self_dir/farshub-core" \
           "$BIN_DIR/farshub-core"; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return; }
  done
  c=$(command -v farshub-core 2>/dev/null) && { printf '%s\n' "$c"; return; }
  die 'موتور اجرا پیدا نشد. اول «farshub install» را اجرا کنید.'
}

# نسخه‌ی موتور، پاک‌شده از برندینگ و لینک فروشنده‌ی آپ‌استریم.
core_version() {
  core=$(find_core)
  "$core" -v 2>/dev/null |
    sed -e 's#https\{0,1\}://[^[:space:]]*##g' \
        -e 's/[Bb]ackhaul[[:space:]]*\([Pp]remium\)\{0,1\}//g' \
        -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' |
    sed -n '/[0-9]/{p;q;}'
}

# ------------------------------------------------------------------ DNS --
# حل دامنه‌ی remote_addr برای status و check. getent روی توزیع‌های سرور
# همیشه هست؛ نبودش (ویندوز، کانتینر مینیمال) بی‌صدا رد می‌شود — خروجی
# خالی یعنی «نمی‌دانم»، نه «سالم است».
resolve_host() {                    # $1=دامنه یا IP → IPها، هر خط یکی
  getent hosts "$1" 2>/dev/null | awk 'NF{print $1}' | sort -u
}

# هاستِ remote_addr جدا از پورت. «[v6]:port» و «host:port» و «host» تنها.
addr_host() {
  case "$1" in
    \[*\]:*) h=${1%%]*}; printf '%s\n' "${h#\[}" ;;
    *:*)     printf '%s\n' "${1%%:*}" ;;
    *)       printf '%s\n' "$1" ;;
  esac
}

# IP همتا از خروجی ss، با پاک‌کردن پیشوند IPv4-map شده. سوکت dual-stack (که
# موتور اجرا هست) همتاها را به شکل [::ffff:1.2.3.4]:port می‌دهد؛ آن پیشوند
# هم کلید state را شلوغ می‌کند هم کارت پنل — IPv4 ساده‌ی همان IP است.
peer_ip() {
  _pip=$(addr_host "$1")
  case "$_pip" in '::ffff:'*) _pip=${_pip#'::ffff:'} ;; esac
  printf '%s\n' "$_pip"
}

# بازه‌های پروکسی کلادفلر (cloudflare.com/ips). تطبیق الگویی است نه CIDR
# دقیق — فقط برای هشدار به کار می‌رود، نه تصمیم. remote_addr پشت پروکسی
# CF یعنی ترنسپورت غیر ws هرگز به سرور نمی‌رسد: CF فقط HTTP را عبور می‌دهد
# و کانال کنترل موتور بی‌پایان «unexpected EOF» می‌گیرد (تجربه‌ی تولید).
is_cloudflare_ip() {                # $1=IP → rc 0 اگر در بازه‌های CF بود
  case "$1" in
    104.1[6-9].*|104.2[0-7].*|172.6[4-9].*|172.7[01].*|\
    162.15[89].*|188.114.9[6-9].*|188.114.10[0-9].*|188.114.11[01].*|\
    141.101.6[4-9].*|141.101.[7-9][0-9].*|141.101.1[01][0-9].*|\
    141.101.12[0-7].*|108.162.19[2-9].*|108.162.2[0-5][0-9].*|\
    190.93.24[0-9].*|190.93.25[0-5].*|173.245.4[89].*|173.245.5[0-9].*|\
    173.245.6[0-3].*|198.41.12[89].*|198.41.1[3-9][0-9].*|\
    198.41.2[0-5][0-9].*|103.21.24[4-7].*|103.22.20[0-3].*|\
    103.31.[4-7].*|197.234.24[0-3].*|131.0.7[2-5].*|2606:4700:*|\
    2a06:98c[0-7]:*|2400:cb00:*|2803:f800:*|2405:b500:*|2405:8100:*|\
    2c0f:f248:*) return 0 ;;
  esac
  return 1
}

# ----------------------------------------------------------------- کمک‌ها --
# نام یونیت هم مثل مسیرها باید قابل انزوا باشد، وگرنه تست روی سرور زنده
# «systemctl restart farshub-server» می‌زند و تونل واقعی را می‌خواباند.
UNIT_PREFIX="${FARSHUB_UNIT_PREFIX:-farshub}"

# «سمت» تونل: server = پورت‌ها را Listen می‌کند، client = همیشه Dial می‌کند.
side_conf() {
  case "$1" in
    server|s) printf '%s\n' "$CONF_DIR/server.toml" ;;
    client|c) printf '%s\n' "$CONF_DIR/client.toml" ;;
    *) die "سمت نامعتبر: «$1» (server یا client)" ;;
  esac
}

side_unit() {
  case "$1" in
    server|s) printf '%s-server.service\n' "$UNIT_PREFIX" ;;
    client|c) printf '%s-client.service\n' "$UNIT_PREFIX" ;;
    *) die "سمت نامعتبر: «$1» (server یا client)" ;;
  esac
}

# اگر سمت را ندادند و فقط یکی از دو کانفیگ نصب است، همان را بردار.
guess_side() {
  has_s=0; has_c=0
  [ -f "$CONF_DIR/server.toml" ] && has_s=1
  [ -f "$CONF_DIR/client.toml" ] && has_c=1
  if [ "$has_s" = 1 ] && [ "$has_c" = 0 ]; then printf 'server\n'; return; fi
  if [ "$has_c" = 1 ] && [ "$has_s" = 0 ]; then printf 'client\n'; return; fi
  if [ "$has_s" = 0 ] && [ "$has_c" = 0 ]; then
    die "کانفیگی در $CONF_DIR نیست. «farshub install» را اجرا کنید."
  fi
  die 'هر دو سمت نصب است — صریح بگویید: farshub '"$1"' server|client'
}

# مثل guess_side ولی وقتی هیچ سمتی نصب نیست یا هر دو نصب‌اند، فقط ساکت
# چیزی برنمی‌گرداند. panel-up روی سرور خام به این نیاز دارد.
guess_side_soft() {
  has_s=0; has_c=0
  [ -f "$CONF_DIR/server.toml" ] && has_s=1
  [ -f "$CONF_DIR/client.toml" ] && has_c=1
  if [ "$has_s" = 1 ] && [ "$has_c" = 0 ]; then printf 'server\n'; fi
  if [ "$has_c" = 1 ] && [ "$has_s" = 0 ]; then printf 'client\n'; fi
  return 0
}

need_root() {
  [ "$(id -u)" = 0 ] || die 'این دستور به root نیاز دارد (sudo).'
}

# نصب در مسیرهای پیش‌فرض root می‌خواهد؛ نصب در یک prefix شخصی (متغیرهای
# FARSHUB_*) نه.
need_write() {
  [ "$(id -u)" = 0 ] && return 0
  for d in "$@"; do
    p=$d
    while [ ! -e "$p" ] && [ "$p" != '/' ]; do p=$(dirname -- "$p"); done
    [ -w "$p" ] || die "دسترسی نوشتن به $d نیست — با sudo اجرا کنید."
  done
}

have_systemd() { command -v systemctl >/dev/null 2>&1; }

# مقدار یک کلید از فایل کانفیگ TOML؛ کامنت و گیومه حذف می‌شود.
conf_val() {
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" 2>/dev/null \
    | sed -e 's/[[:space:]]*#.*$//' -e 's/"//g' -e 's/[[:space:]]*$//' \
    | head -n1
}

# ------------------------------------------------------------- panel.json --
# موتور اجرا در /stats نه نقش خودش را می‌گوید، نه نام میزبان، نه نسخه — پس
# پنل «سمت اجرا نامعلوم» نشان می‌دهد و کارت مشخصات سرور خالی می‌ماند. این فایل
# همان چند فقره را کنار پنل می‌گذارد. اختیاری است: نبودش خطا نیست.
jesc() { printf '%s' "${1:-}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# انباره‌ی ساخت شیء JSON: فیلد خالی نوشته نمی‌شود (پنل کلید غایب را از کارت
# مشخصات حذف می‌کند، پس رشته‌ی خالی فقط شلوغی است) و کاما فقط بین فیلدها می‌آید.
NL='
'
jadd()     { _jbuf="${_jbuf:+$_jbuf,$NL}    \"$1\": $2"; }
jadd_str() { [ -n "${2:-}" ] && jadd "$1" "\"$(jesc "$2")\""; return 0; }
jadd_num() {
  case ${2:-} in ''|*[!0-9]*) return 0 ;; esac
  jadd "$1" "$2"
}

host_ip() {
  a=$(hostname -I 2>/dev/null | awk '{print $1}') || a=''
  [ -n "$a" ] || a=$(ip -4 route get 1 2>/dev/null |
        awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}') || a=''
  printf '%s' "$a"
}

panel_json() {
  side=$1
  conf=$(side_conf "$side")

  # فقط سمت server آدرس Listen دارد؛ کلاینت remote_addr دارد که «Bind» نیست.
  bind=''
  if [ "$side" = server ] && [ -f "$conf" ]; then
    bind=$(conf_val "$conf" bind_addr)
  fi

  ver="$BRAND $CLI_VERSION"
  cv=$(core_version 2>/dev/null) || cv=''
  [ -n "$cv" ] && ver="$ver — موتور $cv"

  os=$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-}") || os=''

  _jbuf=''
  jadd_str name   "$(hostname 2>/dev/null || true)"
  jadd_str ip     "$(host_ip)"
  jadd_str bind   "$bind"
  jadd_str os     "$os"
  jadd_str kernel "$(uname -r 2>/dev/null || true)"
  jadd_str arch   "$(uname -m 2>/dev/null || true)"
  jadd_num cores  "$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"

  printf '{\n'
  printf '  "role": "%s",\n'    "$(jesc "$side")"
  printf '  "version": "%s",\n' "$(jesc "$ver")"
  printf '  "host": {\n%s\n'    "$_jbuf"
  printf '  }\n}\n'
}

# --------------------------------------------------------------- راهنما --
cmd_help() {
  cat <<EOF
$BRAND — تونل معکوس برای عبور از NAT و فیلترینگ

استفاده:
  farshub <دستور> [سمت] [گزینه‌ها]

«سمت» یکی از server یا client است. اگر فقط یک سمت روی این ماشین نصب باشد،
می‌توانید ننویسید.

دستورها:
  install <سمت>     نصب موتور، کانفیگ و سرویس systemd روی این ماشین
  run <سمت>         اجرای مستقیم در ترمینال (بدون systemd) — برای عیب‌یابی
  start <سمت>       راه‌اندازی سرویس
  stop <سمت>        توقف سرویس
  restart <سمت>     راه‌اندازی مجدد سرویس
  enable <سمت>      اجرای خودکار در boot + راه‌اندازی فوری
  disable <سمت>     لغو اجرای خودکار + توقف
  status [سمت]      وضعیت سرویس و خلاصه‌ی کانفیگ
  logs [سمت] [-n N] آخرین رویدادها (پیش‌فرض ۵۰ خط)؛ با -f زنده دنبال کن
  config [سمت]      نمایش مسیر و محتوای کانفیگ
  apply-config <سمت> نوشتن کانفیگ از stdin (JSON یا خطوط «کلید=مقدار»)
  edit [سمت]        باز کردن کانفیگ در ویرایشگر (\$EDITOR)
  token             ساخت توکن تصادفی ۳۲ بایتی
  check [سمت]       بررسی سلامت نصب و هشدارهای امنیتی
  peers [سمت]       همتاها و اتصال‌های برقرار به‌صورت JSON — first_seen = شروع همین دوره‌ی اتصال پیوسته
  panel-up [سمت]    بالا آوردن پنل وب: nginx + رمز + فایروال، یک‌جا
  panel-down        برگرداندن همه‌ی تغییرهای panel-up
  panel             توضیح پنل وب و گزینه‌هایش
  panel-meta [سمت]  ساخت panel.json پنل (نقش، نسخه، مشخصات میزبان)
  paths [سمت]       نشان دادن همه‌ی مسیرها و نام‌های این نصب
  version           نسخه‌ی FarsHub و موتور اجرا
  support           راه ارتباط با پشتیبانی
  help              همین متن

گزینه‌های panel-up:
  --port N          پورت پنل (پیش‌فرض 8088)
  --user NAME       نام کاربری ورود (پیش‌فرض farshub)
  --password PASS   رمز دلخواه (ندهید: رمز تصادفی ساخته و چاپ می‌شود)
  --new-password    رمز تصادفی تازه به‌جای حفظ رمز قبلی
  --sniffer         روشن کردن sniffer تا جدول پورت‌ها پر شود

نمونه:
  farshub install server
  farshub token
  farshub edit server
  farshub enable server
  farshub panel-up --sniffer                          # رمز تصادفی
  farshub panel-up --user admin --password MyPass123  # رمز دلخواه
  farshub logs -f

پشتیبانی: $SUPPORT
EOF
}

cmd_support() {
  say "پشتیبانی $BRAND"
  say ''
  say "برای راه‌اندازی، خرید سرور یا رفع اشکال تونل در تلگرام پیام بدهید:"
  say "  $SUPPORT"
}

cmd_version() {
  say "$BRAND $CLI_VERSION"
  cv=$(core_version 2>/dev/null || true)
  [ -n "$cv" ] && say "موتور اجرا: $cv"
  return 0
}

cmd_token() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  elif [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
    od -An -tx1 -N32 /dev/urandom | tr -d ' \n'; printf '\n'
  else
    die 'نه openssl هست و نه /dev/urandom — توکن را دستی بسازید.'
  fi
}

# ----------------------------------------------------------------- اجرا --
# اجرای مستقیم. خروجی موتور از فیلتر برندینگ عبور می‌کند تا کاربر «Backhaul
# Premium» و لینک فروشنده‌ی آپ‌استریم را نبیند. توجه: stderr هم رد می‌شود.
#
# -u (unbuffered) در GNU sed هست ولی در همه‌ی sedها نه؛ یک بار می‌سنجیم، چون
# بدون آن لاگ زنده تا پر شدن بافر معلق می‌ماند.
SED_U=''
if printf '' | sed -u '' >/dev/null 2>&1; then SED_U='-u'; fi

brand_filter() {
  # ترتیب مهم است. دو چیز عمداً بازنویسی *نمی‌شوند*، چون برندینگ نیستند و
  # عوض کردنشان کاربر را گمراه می‌کند:
  #   backhaul.json          نام فایل پیش‌فرض لاگ sniffer — مسیر واقعی روی دیسک
  #   github.com/musix/...   مسیر پکیج در stack trace — برای جست‌وجوی خطا لازم است
  # هر دو اول به یک نشانه تبدیل و آخر برگردانده می‌شوند.
  sed $SED_U \
      -e 's#github\.com/musix/backhaul#@@FH_PKG@@#g' \
      -e 's/backhaul\.json/@@FH_LOG@@/g' \
      -e "s#https\{0,1\}://t\.me/dawsh42#$SUPPORT#g" \
      -e "s/Backhaul Premium/$BRAND/g" \
      -e "s/[Bb]ackhaul/FarsHub/g" \
      -e 's/@@FH_LOG@@/backhaul.json/g' \
      -e 's#@@FH_PKG@@#github.com/musix/backhaul#g'
}

cmd_run() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side run)
  conf=$(side_conf "$side")
  [ -f "$conf" ] || die "کانفیگ نیست: $conf"
  core=$(find_core)
  say "$BRAND — اجرای مستقیم سمت $side ($conf)"
  say 'برای توقف Ctrl+C. برای اجرای دائمی از farshub enable استفاده کنید.'
  say ''
  # pipe کد خروج را می‌خورد (sh POSIX ‏PIPESTATUS ندارد)، پس آن را از یک فایل
  # موقت برمی‌گردانیم — عیب‌یابی بدون کد خروج درست بی‌فایده است. `|| rc=$?`
  # هم لازم است تا set -e زیرپوسته را قبل از نوشتن فایل نکشد.
  # 2>&1 لازم است چون موتور لاگ را روی stderr می‌نویسد.
  rcf=$(mktemp) || die 'ساخت فایل موقت ناموفق بود.'
  { rc=0; "$core" -c "$conf" 2>&1 || rc=$?; printf '%s' "$rc" >"$rcf"; } | brand_filter
  rc=$(cat "$rcf" 2>/dev/null || printf 1); rm -f "$rcf"
  return "${rc:-1}"
}

# نقطه‌ی ورود یونیت‌های systemd. برخلاف run هیچ pipe ندارد: با exec جای همین
# پروسه را می‌گیرد، پس systemd خود موتور را می‌بیند و کد خروج و سیگنال‌ها
# دست‌نخورده می‌مانند. فیلتر برندینگ اینجا اعمال نمی‌شود چون `farshub logs`
# هنگام خواندن فیلتر می‌کند.
cmd_exec() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side run)
  conf=$(side_conf "$side")
  [ -f "$conf" ] || die "کانفیگ نیست: $conf"
  core=$(find_core)
  exec "$core" -c "$conf"
}

# ------------------------------------------------------------- systemd --
svc() {
  action=$1; side=${2:-}
  [ -n "$side" ] || side=$(guess_side "$action")
  have_systemd || die 'systemctl در دسترس نیست. از «farshub run» استفاده کنید.'
  unit=$(side_unit "$side")
  case "$action" in
    start|stop|restart) need_root; systemctl "$action" "$unit"
      say "سرویس $side: $action انجام شد." ;;
    enable)  need_root; systemctl enable --now "$unit"
      say "سرویس $side فعال شد و در boot خودکار بالا می‌آید." ;;
    disable) need_root; systemctl disable --now "$unit"
      say "سرویس $side غیرفعال و متوقف شد." ;;
  esac
}

cmd_status() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side status)
  # نرمال‌سازی alias کوتاه (s/c) — وگرنه مقایسه‌های «= client» بی‌صدا
  # رد می‌شوند و مثلاً خط resolved در «status c» حذف می‌شود.
  case "$side" in server|s) side=server ;; client|c) side=client ;; esac
  conf=$(side_conf "$side")
  unit=$(side_unit "$side")

  say "$BRAND — وضعیت سمت $side"
  say ''
  if have_systemd; then
    state=$(systemctl is-active "$unit" 2>/dev/null || true)
    boot=$(systemctl is-enabled "$unit" 2>/dev/null || true)
    case "$state" in
      active) say '  سرویس        : در حال اجرا' ;;
      inactive) say '  سرویس        : متوقف' ;;
      failed) say '  سرویس        : خطا — «farshub logs» را ببینید' ;;
      *) say "  سرویس        : ${state:-نصب نشده}" ;;
    esac
    case "$boot" in
      enabled) say '  اجرا در boot : بله' ;;
      disabled) say '  اجرا در boot : خیر' ;;
      *) say "  اجرا در boot : ${boot:-نامعلوم}" ;;
    esac
  else
    say '  سرویس        : systemd در دسترس نیست'
  fi
  say "  کانفیگ       : $conf"

  # خلاصه‌ی مقادیر کلیدی؛ token هرگز چاپ نمی‌شود.
  if [ -f "$conf" ]; then
    for k in transport bind_addr remote_addr web_port log_level pprof; do
      v=$(sed -n "s/^[[:space:]]*$k[[:space:]]*=[[:space:]]*//p" "$conf" \
          | sed -e 's/[[:space:]]*#.*$//' -e 's/"//g' -e 's/[[:space:]]*$//' \
          | head -n1)
      [ -n "$v" ] && printf '  %-12s : %s\n' "$k" "$v"
    done
    grep -q '^[[:space:]]*token[[:space:]]*=[[:space:]]*"CHANGE_ME"' "$conf" &&
      say '  ⚠ توکن هنوز CHANGE_ME است — «farshub token» و بعد «farshub edit».'

    # سمت کلاینت: remote_addr واقعاً به کجا حل می‌شود؟ دامنه‌ی پشت CDN
    # همین‌جا لو می‌رود — علت شماره‌ی یکِ «تونل وصل نمی‌شود».
    if [ "$side" = client ]; then
      ra=$(sed -n "s/^[[:space:]]*remote_addr[[:space:]]*=[[:space:]]*//p" "$conf" \
           | sed -e 's/[[:space:]]*#.*$//' -e 's/"//g' -e 's/[[:space:]]*$//' | head -n1)
      if [ -n "$ra" ]; then
        ips=$(resolve_host "$(addr_host "$ra")" | paste -sd' ' -)
        [ -n "$ips" ] && printf '  %-12s : %s\n' "resolved" "$ips"
      fi
    fi
  fi
  say ''
  say "پشتیبانی: $SUPPORT"
}

cmd_logs() {
  side=''; lines=50; follow=0
  while [ $# -gt 0 ]; do
    case $1 in
      -f|--follow) follow=1 ;;
      -n) shift; lines=${1:-50} ;;
      -n*) lines=${1#-n} ;;
      server|s|client|c) side=$1 ;;
      *) die "گزینه‌ی ناشناس: $1" ;;
    esac
    shift
  done
  [ -n "$side" ] || side=$(guess_side logs)
  have_systemd || die 'systemctl نیست؛ لاگ سرویس در دسترس نیست.'
  unit=$(side_unit "$side")
  if [ "$follow" = 1 ]; then
    journalctl -u "$unit" -n "$lines" -f --no-pager | brand_filter
  else
    journalctl -u "$unit" -n "$lines" --no-pager | brand_filter
  fi
}

cmd_config() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side config)
  conf=$(side_conf "$side")
  [ -f "$conf" ] || die "کانفیگ نیست: $conf"
  say "# $conf"
  say ''
  # توکن ماسک می‌شود، ولی جای‌نگهدار CHANGE_ME نه: راز نیست، و دیدنش تنها
  # راهی است که پنل بفهمد توکن هنوز تنظیم نشده (توکن واقعی هیچ‌وقت بیرون
  # نمی‌رود، پس طولش هم قابل سنجش نیست).
  # «b» بی‌برچسب یعنی از اسکریپت بیرون بزن، پس خط CHANGE_ME به ماسک نمی‌رسد.
  sed '/^[[:space:]]*token[[:space:]]*=[[:space:]]*"CHANGE_ME"/b
       s/^\([[:space:]]*token[[:space:]]*=[[:space:]]*\).*/\1"********"   # مخفی شده/' "$conf"
}

cmd_edit() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side edit)
  conf=$(side_conf "$side")
  [ -f "$conf" ] || die "کانفیگ نیست: $conf"
  ed=${EDITOR:-${VISUAL:-}}
  if [ -z "$ed" ]; then
    for e in nano vim vi; do command -v "$e" >/dev/null 2>&1 && { ed=$e; break; }; done
  fi
  [ -n "$ed" ] || die 'ویرایشگری پیدا نشد. $EDITOR را ست کنید.'
  "$ed" "$conf"
  say 'برای اعمال تغییرات: farshub restart '"$side"
}

# ------------------------------------------------------------------ نصب --
# منبع فایل‌های نصب: مخزن اگر کنار اسکریپت باشد، وگرنه نسخه‌ای که نصب قبلی
# در $PAYLOAD_DIR گذاشته. بدون این، «sudo farshub install client» از مسیر
# API شکست می‌خورد — آن‌جا اسکریپت در /usr/local/bin است و مخزنی کنارش نیست.
find_payload() {
  if [ -f "$self_dir/../configs/server.toml" ]; then
    (CDPATH= cd -- "$self_dir/.." && pwd)
  elif [ -f "$PAYLOAD_DIR/configs/server.toml" ]; then
    printf '%s\n' "$PAYLOAD_DIR"
  else
    die "فایل‌های نصب پیدا نشد — نه کنار اسکریپت، نه در $PAYLOAD_DIR."
  fi
}

# وقتی مسیرها یا نام یونیت override شده‌اند، سرویس باید همان محیط را ببیند
# وگرنه _exec کانفیگ پیش‌فرض را برمی‌دارد.
write_unit_env() {                      # $1=مسیر drop-in  $2=سمت
  mkdir -p "$(dirname -- "$1")"
  cat >"$1" <<EOF
# ساخته‌ی «farshub install» — چون مسیرهای FARSHUB_* پیش‌فرض نبودند.
[Service]
Environment=FARSHUB_CONF_DIR=$CONF_DIR
Environment=FARSHUB_LIBEXEC=$LIBEXEC
Environment=FARSHUB_BIN_DIR=$BIN_DIR
Environment=FARSHUB_UNIT_DIR=$UNIT_DIR
Environment=FARSHUB_LOG_DIR=$LOG_DIR
Environment=FARSHUB_STATE_DIR=$STATE_DIR
Environment=FARSHUB_UNIT_PREFIX=$UNIT_PREFIX
ExecStart=
ExecStart=$BIN_DIR/farshub _exec $2
EOF
  chmod 644 "$1"
}

cmd_install() {
  side=${1:-}
  [ -n "$side" ] || die 'سمت را بگویید: farshub install server|client'
  case "$side" in server|s) side=server ;; client|c) side=client ;;
    *) die "سمت نامعتبر: «$side»" ;; esac
  need_write "$LIBEXEC" "$BIN_DIR" "$CONF_DIR" "$LOG_DIR" "$STATE_DIR"

  # کانفیگ‌ها و یونیت‌ها: از مخزن یا از payload نصب قبلی.
  repo=$(find_payload)
  # موتور اجرا: کنار اسکریپت (مخزن) یا جایی که نصب قبلی گذاشته.
  core=''
  for c in "$self_dir/farshub-core" "$LIBEXEC/farshub-core" \
           "$BIN_DIR/farshub-core"; do
    [ -f "$c" ] && { core=$c; break; }
  done
  [ -n "$core" ] || die 'farshub-core نه کنار این اسکریپت است و نه نصب شده.'

  say "نصب $BRAND — سمت $side"

  # اگر همان فایل مقصد است، cp روی خودش خطا می‌دهد.
  [ "$core" = "$LIBEXEC/farshub-core" ] ||
    install -Dm755 "$core" "$LIBEXEC/farshub-core"
  [ "$self_dir/farshub" = "$BIN_DIR/farshub" ] ||
    install -Dm755 "$self_dir/farshub" "$BIN_DIR/farshub"
  say "  موتور  → $LIBEXEC/farshub-core"
  say "  دستور  → $BIN_DIR/farshub"

  if [ -f "$CONF_DIR/$side.toml" ]; then
    say "  کانفیگ → $CONF_DIR/$side.toml (موجود بود، دست نخورد)"
  else
    install -Dm600 "$repo/configs/$side.toml" "$CONF_DIR/$side.toml"
    say "  کانفیگ → $CONF_DIR/$side.toml"
  fi

  install -d -m755 "$LOG_DIR" "$STATE_DIR"

  # پنل وب. فایل‌های موجود بازنویسی می‌شوند (کد است، نه کانفیگ) ولی چیزی که
  # کاربر خودش اضافه کرده حذف نمی‌شود. devserver.py هرگز نباید سرو شود.
  if [ -d "$repo/web" ]; then
    install -d -m755 "$STATE_DIR/web"
    cp -R "$repo/web/." "$STATE_DIR/web/"
    rm -f "$STATE_DIR/web/devserver.py"
    chmod -R u=rwX,go=rX "$STATE_DIR/web"
    panel_json "$side" >"$STATE_DIR/web/panel.json"
    chmod 644 "$STATE_DIR/web/panel.json"
    say "  پنل    → $STATE_DIR/web"
  fi

  # payload تا نصب سمت دوم بی‌مخزن هم کار کند. اگر منبع خودِ payload بود
  # (نصب دوم از /usr/local/bin) کپی روی خودش خطا می‌دهد، پس رد می‌شود.
  if [ "$repo" != "$PAYLOAD_DIR" ]; then
    install -d -m755 "$PAYLOAD_DIR/configs" "$PAYLOAD_DIR/systemd"
    cp "$repo/configs/server.toml" "$repo/configs/client.toml" "$PAYLOAD_DIR/configs/"
    cp "$repo/systemd/farshub-server.service" "$repo/systemd/farshub-client.service" \
       "$PAYLOAD_DIR/systemd/"
    chmod -R u=rwX,go=rX "$PAYLOAD_DIR"
    say "  منبع   → $PAYLOAD_DIR"
  fi

  # نوشتن فایل یونیت به systemd گره نمی‌خورد — فقط daemon-reload.
  unit=$(side_unit "$side")
  install -Dm644 "$repo/systemd/farshub-$side.service" "$UNIT_DIR/$unit"
  say "  سرویس  → $UNIT_DIR/$unit"
  if [ "$UNIT_PREFIX" != 'farshub' ] || [ "$CONF_DIR" != '/etc/farshub' ] ||
     [ "$BIN_DIR" != '/usr/local/bin' ] || [ "$STATE_DIR" != '/var/lib/farshub' ]; then
    write_unit_env "$UNIT_DIR/$unit.d/10-farshub-env.conf" "$side"
    say "  محیط   → $UNIT_DIR/$unit.d/10-farshub-env.conf"
  fi
  if have_systemd; then
    systemctl daemon-reload
  else
    say '  سرویس  → daemon-reload رد شد (systemd نیست)'
  fi

  say ''
  say 'گام بعد:'
  say '  1) farshub token          # توکن بساز'
  say "  2) farshub edit $side     # توکن و پورت‌ها را بگذار"
  say "  3) farshub enable $side   # راه‌اندازی و اجرای خودکار در boot"
  say '  4) farshub panel-up       # پنل وب (اختیاری) — nginx + رمز + فایروال'
  say ''
  say 'توکن باید در دو طرف تونل عیناً یکسان باشد.'
}

# ---------------------------------------------------------------- بررسی --
# هشدارهای امنیتی همان‌هایی است که در README مستند شده — اینجا روی نصب
# واقعی سنجیده می‌شود، نه فقط توصیه.
cmd_check() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side check)
  # نرمال‌سازی alias کوتاه (s/c) — وگرنه بررسی CDN در «check c» بی‌صدا
  # رد می‌شود.
  case "$side" in server|s) side=server ;; client|c) side=client ;; esac
  conf=$(side_conf "$side")
  warn=0

  say "$BRAND — بررسی نصب سمت $side"
  say ''

  if core=$(find_core 2>/dev/null); then
    say "  ✓ موتور اجرا: $core"
  else
    say '  ✗ موتور اجرا پیدا نشد'; warn=$((warn + 1))
  fi

  if [ -f "$conf" ]; then
    say "  ✓ کانفیگ: $conf"
    perm=$(stat -c '%a' "$conf" 2>/dev/null || echo '?')
    case "$perm" in
      600|400) say "  ✓ دسترسی کانفیگ: $perm" ;;
      ?) say '  … دسترسی کانفیگ خوانده نشد' ;;
      *) say "  ✗ دسترسی کانفیگ $perm — توکن قابل خواندن است. chmod 600 بزنید."
         warn=$((warn + 1)) ;;
    esac
  else
    say "  ✗ کانفیگ نیست: $conf"; warn=$((warn + 1))
  fi

  if [ -f "$conf" ]; then
    val() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$conf" \
            | sed -e 's/[[:space:]]*#.*$//' -e 's/"//g' -e 's/[[:space:]]*$//' | head -n1; }

    [ "$(val token)" = 'CHANGE_ME' ] && {
      say '  ✗ توکن هنوز CHANGE_ME است — تونل با این مقدار امن نیست'
      warn=$((warn + 1)); }

    t=$(val transport)
    case "$t" in
      wss|wssmux) say "  ✓ ترانسپورت $t (رمزنگاری‌شده)" ;;
      '') ;;
      *) say "  ⚠ ترانسپورت $t رمزنگاری ندارد — برای رمزنگاری wss یا wssmux" ;;
    esac

    w=$(val web_port)
    if [ -n "$w" ] && [ "$w" != '0' ]; then
      # panel-up پورت را با drop-in سرویس از بیرون می‌بندد؛ وجود همان فایل
      # تفاوت «باز روی اینترنت» و «فقط از خود ماشین» است.
      if [ -f "$UNIT_DIR/$(side_unit "$side").d/10-firewall.conf" ]; then
        say "  ✓ web_port=$w روشن است و با فایروال فقط از خود ماشین باز است"
      else
        say "  ⚠ web_port=$w باز است و احراز هویت ندارد — «farshub panel-up» ببندیدش"
      fi
    fi

    [ "$(val pprof)" = 'true' ] &&
      { say '  ✗ pprof=true — روی 0.0.0.0:6060 بدون auth باز می‌شود'
        warn=$((warn + 1)); }

    [ "$(val log_level)" = 'info' ] &&
      say '  ⚠ log_level=info مقدار توکن را در خطای mismatch لاگ می‌کند'

    # سمت کلاینت: remote_addr پشت پروکسی کلادفلر با ترنسپورت غیر ws*
    # کار نمی‌کند — CF فقط HTTP را عبور می‌دهد و کانال کنترل بی‌پایان
    # «unexpected EOF» می‌گیرد. برای ws* عبور از CDN خودِ طراحی است
    # (edge_ip)، پس آن‌ها را نمی‌سنجم.
    if [ "$side" = client ]; then
      case "$(val transport)" in
        ws*) ;;
        *)
          ra=$(val remote_addr)
          if [ -n "$ra" ]; then
            host=$(addr_host "$ra")
            ips=$(resolve_host "$host")
            if [ -n "$ips" ]; then
              cdn=''
              for ip in $ips; do is_cloudflare_ip "$ip" && cdn=1; done
              if [ -n "$cdn" ]; then
                say "  ✗ remote_addr ($host) به CDN کلادفلر حل می‌شود — پروکسی CF"
                say '    ترافیک غیر HTTP را عبور نمی‌دهد و تونل برقرار نمی‌شود.'
                say '    IP مستقیم سرور یا رکورد DNS-only (ابر خاکستری) بگذارید.'
                warn=$((warn + 1))
              else
                say "  ✓ remote_addr حل شد: $(printf '%s\n' "$ips" | paste -sd' ' -)"
              fi
            fi
          fi
          ;;
      esac
    fi
  fi

  if have_systemd; then
    unit=$(side_unit "$side")
    if [ -f "$UNIT_DIR/$unit" ]; then
      say "  ✓ سرویس: $unit"
    else
      say "  ⚠ یونیت systemd نصب نیست: $unit"
    fi
  fi

  say ''
  if [ "$warn" = 0 ]; then
    say 'مشکل جدی پیدا نشد.'
  else
    say "$warn مورد نیاز به رسیدگی دارد."
  fi
  say "پشتیبانی: $SUPPORT"
  [ "$warn" = 0 ]
}

# ----------------------------------------------------------------- peers --
# مشاهده‌ی زنده‌ی تونل: چه همتایی وصل است و از کِی، و در سمت سرور مصرف هر پورت.
# خروجی JSON و فقط روی stdout است تا هم پنل هم اسکریپت بخوانندش. منابع — ss برای
# اتصال‌ها و /data و /stats موتور برای پورت‌ها و وضعیت — همه اختیاری‌اند: نبودِ
# جواب یعنی «داده‌ی خالی»، نه خطا. تنها خطاها خطای کاربرند: سمت، کانفیگ.
cmd_peers() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side peers)
  case "$side" in server|s) side=server ;; client|c) side=client ;;
    *) die "سمت نامعتبر: «$side»" 2 ;; esac
  conf=$(side_conf "$side")
  [ -f "$conf" ] || die "کانفیگ نیست: $conf"

  # یک مهر زمانی برای generated_at و state — دو بار date زدن یعنی دو پاسِ متفاوت
  # از «الان» در یک خروجی.
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  transport=$(conf_val "$conf" transport)
  stf="$STATE_DIR/peers-state.json"

  # ss فقط با همین فراخوانی پرسیده می‌شود. نبودش یا خطایش یعنی «مشاهده‌ای
  # نیست»: خروجی معتبرِ خالی چاپ می‌شود و state دست نمی‌خورد — پاک کردن
  # تاریخچه به‌بهانه‌ی ناتوانی در دیدن، بدترین حالت ممکن است.
  obs=0; sslines=''
  if command -v ss >/dev/null 2>&1; then
    if sslines=$(ss -H -tn state established 2>/dev/null); then obs=1; fi
  fi

  if [ "$side" = server ]; then
    bind=$(conf_val "$conf" bind_addr)
    [ -n "$bind" ] || die 'bind_addr در server.toml نیست — پورت تونل معلوم نیست.'
    tport=${bind##*:}
    case "$tport" in
      ''|*[!0-9]*) die "پورت تونل در bind_addr عدد نیست: «$bind»" ;;
    esac

    # شمارش اتصال به‌ازای IP همتا. ستون State در نسخه‌های مختلف ss گاهی هست و
    # گاهی نیست، پس از انتهای خط خوانده می‌شود: همتا = آخرین ستون، محلی =
    # یکی‌مانده‌به‌آخر — و تطبیق پورت با همان جفت‌نویسه‌ای که port_busy هم
    # به کار می‌برد. first_seen از state می‌آید؛ خطِ ناسالم = همتای تازه.
    info=''
    if [ "$obs" = 1 ]; then
      info=$(printf '%s\n' "$sslines" |
        awk -v tp="$tport" 'NF >= 2 {
          loc = $(NF-1); peer = $NF
          if (loc ~ (":" tp "$") || loc ~ ("[.]" tp "$")) print peer
        }' |
        while IFS= read -r pr; do peer_ip "$pr"; done |
        LC_ALL=C sort | uniq -c |
        while read -r n ip; do
          [ -n "${ip:-}" ] || continue
          first=$(sed -n "s|^\"server/$ip\": {\"first_seen\":\"\([^\"]*\)\",\"last_seen\":\"[^\"]*\"},\{0,1\}\$|\1|p" "$stf" 2>/dev/null) || first=''
          [ -n "$first" ] || first=$now
          printf '%s %s %s %s\n' "$ip" "$n" "$first" "$now"
        done)
    fi

    # ports: مصرف هر پورت از /data موتور، محدود به پورت‌های مجازِ کانفیگ. برای
    # همه‌ی همتاها یکسان چون /data انتساب به‌ازای کلاینت ندارد. sniffer خاموش
    # باشد موتور به‌جای JSON صفحه‌ی HTML می‌دهد — همان لیست خالی تلقی می‌شود.
    ports_json='[]'
    wp=$(conf_val "$conf" web_port)
    if [ -n "$wp" ] && [ "$wp" != 0 ]; then
      data=$(curl -s --max-time 3 "http://127.0.0.1:$wp/data" 2>/dev/null) || data=''
      data=$(printf '%s' "$data" | tr -d '\n' | sed 's/^[[:space:]]*//')
      case "$data" in
        '['*'"Port":'*)
          # فهرست مجاز از بلوک ports کانفیگ: سمت چپِ هر مدخل تا «=»، بدون
          # پیشوند IP بایند — «127.0.0.2:443=…» یعنی پورت 443.
          allowed=''
          while IFS= read -r row; do
            [ -n "$row" ] || continue
            lp=${row%%=*}
            case "$lp" in
              [0-9]*.[0-9]*.[0-9]*.[0-9]*:*) lp=${lp#*:} ;;
              *:*)                           lp=${lp%%:*} ;;
            esac
            allowed="$allowed $lp"
          done <<EOF
$(sed -n '/^[[:space:]]*ports[[:space:]]*=[[:space:]]*\[/,/\]/p' "$conf" |
   sed -e 's/[[:space:]]*#.*$//' \
       -e 's/^[[:space:]]*ports[[:space:]]*=[[:space:]]*\[//' \
       -e 's/\].*$//' -e 's/"//g' -e 's/,//g' | tr ' \t' '\n\n' |
   sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' || true)
EOF
          pj=''
          while IFS= read -r chunk; do
            [ -n "$chunk" ] || continue
            dp=$(printf '%s' "$chunk" | sed -n 's/.*"Port":\([0-9][0-9]*\).*/\1/p')
            [ -n "$dp" ] || continue
            ok=0
            for spc in $allowed; do
              case "$spc" in
                *-*)
                  if [ "$dp" -ge "${spc%%-*}" ] && [ "$dp" -le "${spc#*-}" ]; then ok=1; fi ;;
                *)
                  if [ "$dp" = "$spc" ]; then ok=1; fi ;;
              esac
            done
            if [ "$ok" = 1 ]; then
              du=$(printf '%s' "$chunk" | sed -n 's/.*"ReadableUsage":"\([^"]*\)".*/\1/p')
              [ -n "$pj" ] && pj="$pj, "
              pj="$pj{ \"port\": $dp, \"usage\": \"$(jesc "$du")\" }"
            fi
          done <<EOF
$(printf '%s' "$data" | sed 's/},{/},\n{/g')
EOF
          if [ -n "$pj" ]; then ports_json="[ $pj ]"; fi
          ;;
      esac
    fi

    # state: ماندگاریِ نخستین دیده‌شدنِ همین دوره‌ی پیوسته. همتایی که در ss
    # نیست حذف می‌شود تا first_seen یعنی «از الان وصل است»، نه «سال پیش دیده
    # شد». نوشتن اتمیک با mv، به رسم apply-config.
    if [ "$obs" = 1 ]; then
      body=''
      while read -r ip n first last; do
        [ -n "${ip:-}" ] || continue
        body="$body\"server/$ip\": {\"first_seen\":\"$first\",\"last_seen\":\"$last\"},
"
      done <<EOF
$info
EOF
      body=${body%',
'}
      mkdir -p "$STATE_DIR" 2>/dev/null || true
      tmp="$stf.new.$$"
      if [ -n "$body" ]; then printf '{\n%s\n}\n' "$body" >"$tmp"
      else printf '{\n}\n' >"$tmp"; fi
      mv "$tmp" "$stf"
    fi

    printf '{\n'
    printf '  "side": "server",\n'
    printf '  "generated_at": "%s",\n' "$now"
    printf '  "transport": "%s",\n' "$(jesc "$transport")"
    printf '  "tunnel_port": %s,\n' "$tport"
    if [ -z "$info" ]; then
      printf '  "clients": []\n'
    else
      printf '  "clients": [\n'
      ent=0
      while read -r ip n first last; do
        [ -n "${ip:-}" ] || continue
        ent=$((ent + 1))
        [ "$ent" -gt 1 ] && printf ',\n'
        printf '    {\n'
        printf '      "ip": "%s",\n' "$(jesc "$ip")"
        printf '      "connections": %s,\n' "$n"
        printf '      "first_seen": "%s",\n' "$first"
        printf '      "last_seen": "%s",\n' "$last"
        printf '      "ports": %s\n' "$ports_json"
        printf '    }'
      done <<EOF
$info
EOF
      printf '\n  ]\n'
    fi
    printf '}\n'
    return 0
  fi

  # ---------------------------------------------------------- سمت کلاینت --
  ra=$(conf_val "$conf" remote_addr)
  host=''; rport=''
  if [ -n "$ra" ]; then
    host=$(addr_host "$ra")
    rport=${ra##*:}
  fi
  # resolved_ip: خودِ host اگر IP literal باشد (بی‌نیاز از DNS)؛ وگرنه اولین
  # پاسخ DNS. برای شمارش، همه‌ی IPهای حل‌شده پذیرفته می‌شوند — نمایش فقط اولی.
  rip=''
  if [ -n "$host" ]; then
    case "$host" in
      *:*) if printf '%s' "$host" |
               grep -Eq '^([0-9A-Fa-f]{0,4}:){1,7}[0-9A-Fa-f]{0,4}$'; then rip=$host; fi ;;
      *)   if valid_ipv4 "$host"; then rip=$host; fi ;;
    esac
  fi
  allips=''
  if [ -n "$rip" ]; then
    allips=$host
  elif [ -n "$host" ]; then
    allips=$(resolve_host "$host")
    rip=$(printf '%s\n' "$allips" | head -n 1)
  fi

  # شمارش اتصال به سرور: همتای ss (آخرین ستون) باید یکی از IPهای حل‌شده باشد
  # و پورتش همان پورت remote_addr. DNS نباشد و host دامنه باشد → صفر، نه خطا.
  conns=0
  if [ "$obs" = 1 ] && [ -n "$rport" ] && [ -n "$allips" ]; then
    conns=$(printf '%s\n' "$sslines" |
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        peer=$(printf '%s' "$line" | awk 'NF > 0 {print $NF}')
        [ -n "$peer" ] || continue
        ph=$(peer_ip "$peer")
        pp=${peer##*:}
        [ "$pp" = "$rport" ] || continue
        if printf '%s\n' "$allips" | grep -qx "$ph"; then printf 'x\n'; fi
      done | wc -l)
    conns=$(printf '%s' "$conns" | tr -d ' ')
  fi

  # وضعیت تونل از /stats موتور؛ خودش را موتور گزارش می‌کند، ما فقط منتقلش
  # می‌کنیم. web_port خاموش یا پاسخ نامعتبر → «unknown»، نه حدس زدن.
  status='unknown'
  wp=$(conf_val "$conf" web_port)
  if [ -n "$wp" ] && [ "$wp" != 0 ]; then
    stats=$(curl -s --max-time 3 "http://127.0.0.1:$wp/stats" 2>/dev/null) || stats=''
    tstat=$(printf '%s' "$stats" | sed -n 's/.*"tunnelStatus" *: *"\([^"]*\)".*/\1/p')
    if [ -n "$tstat" ]; then status=$tstat; fi
  fi

  # state با همان قاعده‌ی سمت سرور: هسته، «همین دوره‌ی پیوسته».
  first=''; last=''
  if [ "$obs" = 1 ]; then
    if [ "$conns" -gt 0 ]; then
      pkey="client/${rip:-$host}"
      first=$(sed -n "s|^\"$pkey\": {\"first_seen\":\"\([^\"]*\)\",\"last_seen\":\"[^\"]*\"},\{0,1\}\$|\1|p" "$stf" 2>/dev/null) || first=''
      [ -n "$first" ] || first=$now
      last=$now
      body="\"$pkey\": {\"first_seen\":\"$first\",\"last_seen\":\"$last\"}"
    else
      body=''
    fi
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    tmp="$stf.new.$$"
    if [ -n "$body" ]; then printf '{\n%s\n}\n' "$body" >"$tmp"
    else printf '{\n}\n' >"$tmp"; fi
    mv "$tmp" "$stf"
  fi

  printf '{\n'
  printf '  "side": "client",\n'
  printf '  "generated_at": "%s",\n' "$now"
  printf '  "transport": "%s",\n' "$(jesc "$transport")"
  printf '  "server": {\n'
  printf '    "remote_addr": "%s",\n' "$(jesc "$ra")"
  printf '    "host": "%s",\n' "$(jesc "$host")"
  printf '    "resolved_ip": "%s",\n' "$(jesc "$rip")"
  printf '    "connections": %s,\n' "$conns"
  printf '    "first_seen": "%s",\n' "$first"
  printf '    "last_seen": "%s",\n' "$last"
  printf '    "tunnel_status": "%s"\n' "$(jesc "$status")"
  printf '  }\n}\n'
}

cmd_panel() {
  # این دستور فقط توضیح می‌دهد. اگر کسی گزینه‌ای بدهد، انتظارش «انجام دادن»
  # است — پس بی‌صدا نخوریمش، وگرنه فکر می‌کند رمز عوض شد و نشده.
  if [ $# -gt 0 ]; then
    say '«panel» فقط توضیح می‌دهد و گزینه نمی‌گیرد. دستوری که کار می‌کند panel-up است:'
    say ''
    # همان خط تایپ‌شده را پیشنهاد بده، با یک اصلاح: «--new-password رمز»
    # رایج‌ترین اشتباه است — آن سوئیچ مقدار نمی‌گیرد و رمز تصادفی می‌سازد.
    # چیزی که خواسته شده --password است. بقیه‌ی گزینه‌ها دست‌نخورده می‌مانند.
    hint=''
    while [ $# -gt 0 ]; do
      if [ "$1" = '--new-password' ] && [ $# -ge 2 ]; then
        case $2 in
          -*) ;;
          *)  hint="$hint --password $2"; shift 2; continue ;;
        esac
      fi
      hint="$hint $1"
      shift
    done
    say "  sudo farshub panel-up$hint"
    say ''
    say 'فهرست گزینه‌ها:  farshub panel'
    exit 2
  fi
  say "$BRAND — پنل وب"
  say ''
  say 'پنل FarsHub ایستا، دوزبانه و بدون CDN است. «farshub install» آن را در'
  say "$STATE_DIR/web می‌گذارد، همراه یک panel.json که نقش این ماشین،"
  say 'نسخه و مشخصات میزبان را نگه می‌دارد — موتور اجرا هیچ‌کدام را گزارش'
  say 'نمی‌کند و بدون این فایل پنل «سمت اجرا نامعلوم» نشان می‌دهد.'
  say ''
  say 'بالا آوردن پنل (رمز خودکار ساخته و چاپ می‌شود):'
  say ''
  say '  sudo farshub panel-up --sniffer'
  say ''
  say 'با کاربر و رمز دلخواه:'
  say ''
  say '  sudo farshub panel-up --user admin --password MyPass123 --sniffer'
  say ''
  say 'panel-up اگر nginx نباشد نصبش می‌کند، web_port موتور را روشن و همان را'
  say 'از بیرون می‌بندد، و پنل را با auth_basic سرو می‌کند.'
  say ''
  say '  --port N        پورت پنل (پیش‌فرض 8088)'
  say '  --user NAME     نام کاربری (پیش‌فرض farshub)'
  say '  --password PASS رمز دلخواه (نگذارید: رمز تصادفی ساخته می‌شود)'
  say '  --new-password  رمز تصادفی تازه به‌جای حفظ رمز قبلی'
  say '  --sniffer       تا جدول پورت‌ها پر شود'
  say ''
  say 'عوض کردن رمزِ بعدی:  sudo farshub panel-up --password رمزتازه'
  say 'برگرداندن همه‌ی تغییرها:  sudo farshub panel-down'
  say ''
  say 'اگر نقش را دستی عوض کردید:'
  say "  farshub panel-meta server > $STATE_DIR/web/panel.json"
  say ''
  say 'پنل داخلی خود موتور اجرا چیز دیگری است، برندینگ آپ‌استریم را دارد و'
  say 'احراز هویت ندارد — panel-up عمداً آن را از بیرون بسته نگه می‌دارد.'
  say ''
  say 'جزئیات: docs/PANEL.md'
}

# ------------------------------------------------------ بالا آوردن پنل --
# دستی‌کردن این کار چهار مرحله دارد و هر مرحله یک جای اشتباهِ امنیتی: روشن
# کردن web_port موتور، بستن همان پورت از بیرون، nginx با رمز جلوی پنل، و
# panel.json. panel-up هر چهار را با هم انجام می‌دهد و panel-down برمی‌گرداند.
PANEL_STATE="$STATE_DIR/panel.conf"
API_STATE="$STATE_DIR/api.conf"
HTPASSWD_FILE="${FARSHUB_HTPASSWD:-/etc/nginx/farshub.htpasswd}"
SITE_NAME="${FARSHUB_SITE_NAME:-farshub-panel}"
PAYLOAD_DIR="$STATE_DIR/payload"

# listen [::] روی ماشین بدون IPv6 در bind خطا می‌دهد و کل nginx بالا نمی‌آید.
have_ipv6() { [ -f /proc/net/if_inet6 ]; }

# دبیان/اوبونتو sites-available دارند، رد‌هت conf.d. هر دو را پوشش می‌دهیم و
# نتیجه را در SITE_FILE و SITE_LINK می‌گذاریم (SITE_LINK فقط در حالت اول).
resolve_site_paths() {
  if [ -d /etc/nginx/sites-available ] && [ -d /etc/nginx/sites-enabled ]; then
    SITE_FILE="/etc/nginx/sites-available/$SITE_NAME"
    SITE_LINK="/etc/nginx/sites-enabled/$SITE_NAME"
  else
    SITE_FILE="/etc/nginx/conf.d/$SITE_NAME.conf"
    SITE_LINK=''
  fi
}

pkg_install_nginx() {
  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get update -qq &&
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nginx
  elif command -v dnf >/dev/null 2>&1;    then dnf install -y -q nginx
  elif command -v yum >/dev/null 2>&1;    then yum install -y -q nginx
  elif command -v apk >/dev/null 2>&1;    then apk add --no-cache nginx
  elif command -v pacman >/dev/null 2>&1; then pacman -Sy --noconfirm nginx
  else return 127
  fi
}

NGINX_FRESH=0
ensure_nginx() {
  command -v nginx >/dev/null 2>&1 && return 0
  say '  nginx نصب نیست — نصبش می‌کنم (چند لحظه)…'
  pkg_install_nginx >/dev/null 2>&1 ||
    die 'nginx نصب نشد. دستی نصبش کنید و panel-up را دوباره بزنید.'
  command -v nginx >/dev/null 2>&1 || die 'نصب nginx ناموفق بود.'
  NGINX_FRESH=1
  # سایت پیش‌فرض دبیان روی پورت ۸۰ گوش می‌دهد. اگر چیز دیگری آن پورت را
  # گرفته باشد nginx اصلاً بالا نمی‌آید و پنل هم بالا نمی‌آید — و صفحه‌ی
  # «Welcome to nginx» هم چیزی نیست که کاربر خواسته باشد. فقط لینک را
  # برمی‌داریم، پس با ln -s برگشتنی است. سایت‌های خودِ کاربر دست‌نخورده‌اند،
  # چون این شاخه فقط وقتی اجرا می‌شود که nginx را همین حالا نصب کرده باشیم.
  if [ -L /etc/nginx/sites-enabled/default ]; then
    rm -f /etc/nginx/sites-enabled/default
    say '  nginx   → سایت پیش‌فرض (پورت ۸۰) غیرفعال شد؛ فایلش در sites-available ماند'
  fi
  return 0
}

# مقدار یک کلید عددی/بولی در TOML؛ کامنت انتهای خط دست‌نخورده می‌ماند.
set_conf_val() {                        # $1=فایل  $2=کلید  $3=مقدار
  if grep -q "^[[:space:]]*$2[[:space:]]*=" "$1"; then
    sed -i "s|^\([[:space:]]*$2[[:space:]]*=[[:space:]]*\)[^[:space:]#]*|\1$3|" "$1"
  else
    printf '%s = %s\n' "$2" "$3" >>"$1"
  fi
}

# ---------------------------------------------------- اعتبارسنجی کانفیگ --
# فهرست کلیدها بسته است: در موتور کامپایل شده‌اند و عوض نمی‌شوند
# (docs/UPSTREAM-BACKHAUL.md). هر کلید یک نوع و یک بازه دارد.
#
# چرا این‌قدر سخت‌گیر: مقدار مستقیم داخل الگوی sed می‌نشیند، پس مجموعه‌ی
# نویسه‌های هر نوع طوری بسته شده که «\» و «&» و «|» و گیومه هیچ‌وقت رد نشوند.
# تزریق sed اینجا با ساختار غیرممکن است، نه با escape کردن.

TRANSPORTS='tcp tcpmux ws wss wsmux wssmux udp'
LOG_LEVELS='panic fatal error warn info debug trace'

valid_int() {                           # $1=مقدار $2=کمینه $3=بیشینه
  case $1 in ''|*[!0-9]*) return 1 ;; esac
  [ ${#1} -le 10 ] || return 1
  [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

valid_enum() {                          # $1=مقدار $2=فهرست جدا با فاصله
  for v in $2; do [ "$1" = "$v" ] && return 0; done
  return 1
}

valid_bool() { [ "$1" = true ] || [ "$1" = false ]; }

valid_token() {
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._~-]{32,256}$'
}

valid_path() {
  [ -z "$1" ] && return 0             # "" یعنی تنظیم‌نشده، مجاز است
  printf '%s' "$1" | grep -Eq '^/[A-Za-z0-9._/-]{1,255}$'
}

valid_ipv4() {
  printf '%s' "$1" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || return 1
  for o in $(printf '%s' "$1" | tr '.' ' '); do
    [ "$o" -le 255 ] || return 1
  done
  return 0
}

valid_addr() {                          # host:port — host می‌تواند خالی باشد
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_.:-]{0,253}:[0-9]{1,5}$' || return 1
  valid_int "${1##*:}" 1 65535
}

# ردیف ports:  [bindip:]port[-port][= یا :][remoteip:]port
valid_port_row() {
  printf '%s' "$1" | grep -Eq \
    '^([0-9]{1,3}(\.[0-9]{1,3}){3}:)?[0-9]{1,5}(-[0-9]{1,5})?([=:]([0-9]{1,3}(\.[0-9]{1,3}){3}:)?[0-9]{1,5})?$' ||
    return 1
  # اکتت‌های IP جدا سنجیده می‌شوند، چون regex بالا ۹۹۹ را هم می‌پذیرد
  for ip in $(printf '%s' "$1" | grep -Eo '[0-9]{1,3}(\.[0-9]{1,3}){3}'); do
    valid_ipv4 "$ip" || return 1
  done
  # هر عددی که جزء IP نیست باید پورت معتبر باشد
  rest=$(printf '%s' "$1" | sed -E 's/[0-9]{1,3}(\.[0-9]{1,3}){3}//g')
  for p in $(printf '%s' "$rest" | tr -c '0-9' ' '); do
    valid_int "$p" 1 65535 || return 1
  done
  case $1 in
    *-*)
      lo=${1%%-*}; lo=${lo##*:}
      hi=${1#*-}; hi=${hi%%[=:]*}
      [ "$lo" -le "$hi" ] || return 1
      ;;
  esac
  return 0
}

# نوع و بازه‌ی هر کلید. خروجی: «نوع کمینه بیشینه» یا خالی اگر کلید برای این
# سمت وجود ندارد. مقادیر از docs/UPSTREAM-BACKHAUL.md آمده‌اند.
key_spec() {                            # $1=سمت  $2=کلید
  case "$2" in
    # هر دو سمت
    transport)         printf 'enum\n' ;;
    token)             printf 'token\n' ;;
    keepalive_period)  printf 'int 1 3600\n' ;;
    nodelay)           printf 'bool\n' ;;
    sniffer)           printf 'bool\n' ;;
    sniffer_log)       printf 'path\n' ;;
    web_port)          printf 'int 0 65535\n' ;;
    log_level)         printf 'level\n' ;;
    pprof)             printf 'bool\n' ;;
    mux_version)       printf 'int 1 2\n' ;;
    mux_framesize)     printf 'int 4096 1048576\n' ;;
    mux_recievebuffer) printf 'int 65536 67108864\n' ;;
    mux_streambuffer)  printf 'int 16384 16777216\n' ;;
    tls_cert)          printf 'path\n' ;;
    tls_key)           printf 'path\n' ;;
    # فقط سرور
    bind_addr)         [ "$1" = server ] && printf 'addr\n' ;;
    ports)             [ "$1" = server ] && printf 'ports\n' ;;
    heartbeat)         [ "$1" = server ] && printf 'int 1 300\n' ;;
    channel_size)      [ "$1" = server ] && printf 'int 64 65536\n' ;;
    accept_udp)        [ "$1" = server ] && printf 'bool\n' ;;
    mux_con)           [ "$1" = server ] && printf 'int 1 64\n' ;;
    # فقط کلاینت
    remote_addr)       [ "$1" = client ] && printf 'remote\n' ;;
    edge_ip)           [ "$1" = client ] && printf 'ip\n' ;;
    connection_pool)   [ "$1" = client ] && printf 'int 1 1024\n' ;;
    aggressive_pool)   [ "$1" = client ] && printf 'bool\n' ;;
    retry_interval)    [ "$1" = client ] && printf 'int 1 300\n' ;;
    dial_timeout)      [ "$1" = client ] && printf 'int 1 300\n' ;;
  esac
  return 0
}

# مقدار را می‌سنجد و شکل TOML‌اش را چاپ می‌کند (رشته‌ها با گیومه). خطا ⇒ die.
toml_value() {                          # $1=سمت  $2=کلید  $3=مقدار
  spec=$(key_spec "$1" "$2")
  [ -n "$spec" ] || die "کلید ناشناس یا مربوط به سمت دیگر: «$2»"
  # shellcheck disable=SC2086
  set -- "$1" "$2" "$3" $spec
  case $4 in
    enum)  valid_enum "$3" "$TRANSPORTS" || die "transport نامعتبر: «$3» (یکی از: $TRANSPORTS)"
           printf '"%s"\n' "$3" ;;
    level) valid_enum "$3" "$LOG_LEVELS" || die "log_level نامعتبر: «$3» (یکی از: $LOG_LEVELS)"
           printf '"%s"\n' "$3" ;;
    token) valid_token "$3" || die 'توکن باید ۳۲ تا ۲۵۶ نویسه از [A-Za-z0-9._~-] باشد.'
           printf '"%s"\n' "$3" ;;
    bool)  valid_bool "$3" || die "«$2» باید true یا false باشد، نه «$3»"
           printf '%s\n' "$3" ;;
    int)   valid_int "$3" "$5" "$6" || die "«$2» باید عددی بین $5 و $6 باشد، نه «$3»"
           printf '%s\n' "$3" ;;
    path)  valid_path "$3" || die "«$2» باید مسیر مطلق بدون فاصله باشد: «$3»"
           printf '"%s"\n' "$3" ;;
    ip)    [ -z "$3" ] || valid_ipv4 "$3" || die "«$2» باید IPv4 باشد: «$3»"
           printf '"%s"\n' "$3" ;;
    addr)  valid_addr "$3" || die "«$2» باید host:port با پورت ۱ تا ۶۵۵۳۵ باشد: «$3»"
           printf '"%s"\n' "$3" ;;
    remote)
           valid_addr "$3" || die "«$2» باید host:port با پورت ۱ تا ۶۵۵۳۵ باشد: «$3»"
           case $3 in
             :*|SERVER_IP:*) die 'remote_addr باید نشانی واقعی سرور باشد، نه جای‌نگهدار.' ;;
           esac
           printf '"%s"\n' "$3" ;;
    *)     die "نوع ناشناخته برای «$2»" ;;
  esac
}

# جایگزینی کل بلوک ports. کامنت‌های داخلش (نمونه‌های کانفیگ ارسالی) نگه
# داشته می‌شوند — مستنداتی هستند که کاربر بعداً لازمش دارد.
set_conf_ports() {                      # $1=فایل  $2..=ردیف‌ها
  f=$1
  shift
  keep=$(sed -n '/^[[:space:]]*ports[[:space:]]*=[[:space:]]*\[/,/\]/p' "$f" 2>/dev/null |
           grep -E '^[[:space:]]*#' || true)
  rows=''
  for r in "$@"; do rows="$rows    \"$r\",
"; done
  if [ -z "$rows" ] && [ -z "$keep" ]; then
    block='ports = [ ]
'
  else
    block="ports = [
${keep:+$keep
}$rows]
"
  fi
  awk -v block="$block" '
    BEGIN { done = 0; inside = 0 }
    !done && !inside && /^[ \t]*ports[ \t]*=[ \t]*\[/ {
      printf "%s", block
      if ($0 ~ /\]/) { done = 1; next }
      inside = 1
      next
    }
    inside { if ($0 ~ /\]/) { inside = 0; done = 1 } ; next }
    { print }
    END { if (!done) printf "%s", block }
  ' "$f" >"$f.ports.$$" && mv "$f.ports.$$" "$f"
}

# --------------------------------------------------------- apply-config --
# تنها نویسنده‌ی کانفیگ. دو پاس: اول همه چیز سنجیده می‌شود، بعد نوشته —
# پس کانفیگ نیم‌معتبر هرگز روی دیسک نمی‌رود. جایگزینی با mv در همان
# filesystem اتمیک است.
cmd_apply_config() {
  side=${1:-}
  [ -n "$side" ] || die 'سمت را بگویید: farshub apply-config server|client' 2
  case "$side" in server|s) side=server ;; client|c) side=client ;;
    *) die "سمت نامعتبر: «$side»" 2 ;; esac
  conf=$(side_conf "$side")
  [ -f "$conf" ] || die "کانفیگ نیست: $conf — اول «farshub install $side»."
  need_write "$CONF_DIR"

  raw=$(cat)
  # JSON یا خطوط key=value. JSON را python به خطوط تبدیل می‌کند؛ خودِ CLI
  # وابستگی نمی‌گیرد، چون شکل خطی بدون python کار می‌کند.
  case $raw in
    [[:space:]]*\{*|\{*)
      py=''
      # با اجرا سنجیده می‌شود، نه با command -v: روی ویندوز «python3» یک
      # alias فروشگاه مایکروسافت است که در PATH هست ولی اجرا نمی‌شود.
      for c in python3 python py; do
        "$c" -c 'import json' >/dev/null 2>&1 && { py=$c; break; }
      done
      [ -n "$py" ] ||
        die 'JSON خواندن python3 می‌خواهد. شکل بدون وابستگی: خطوط «کلید=مقدار».'
      # stderr هم گرفته می‌شود، وگرنه پیام خطای python به die نمی‌رسد.
      lines=$(printf '%s' "$raw" | "$py" -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError as e:
    sys.exit("JSON نامعتبر: %s" % e)
if not isinstance(d, dict):
    sys.exit("JSON باید یک شیء باشد.")
out = []
for k, v in d.items():
    if isinstance(v, list):
        if not v:
            out.append("%s=" % k)
        for item in v:
            out.append("%s+=%s" % (k, item))
    elif isinstance(v, bool):
        out.append("%s=%s" % (k, "true" if v else "false"))
    elif v is None:
        out.append("%s=" % k)
    else:
        out.append("%s=%s" % (k, v))
sys.stdout.write("\n".join(out))
' 2>&1) || die "$lines"
      ;;
    *) lines=$raw ;;
  esac

  # ------- پاس یکم: سنجیدن. هیچ نوشتنی در این پاس نیست.
  pending=''                            # «کلید<TAB>مقدارTOML» به‌ازای هر خط
  rows=''                               # ردیف‌های ports
  has_ports=0
  printf '%s\n' "$lines" | tr -d '\r' >"$conf.in.$$"
  while IFS= read -r line; do
    case $line in ''|'#'*) continue ;; esac
    case $line in
      *'+='*)
        k=${line%%+=*}; v=${line#*+=}
        [ "$k" = ports ] || die "«+=» فقط برای ports است، نه «$k»"
        [ -n "$(key_spec "$side" ports)" ] || die 'سمت کلاینت کلید ports ندارد.'
        valid_port_row "$v" || die "ردیف ports نامعتبر: «$v»"
        rows="$rows$v
"
        has_ports=1
        ;;
      *'='*)
        k=${line%%=*}; v=${line#*=}
        case $k in ''|*[!a-z_]*) die "نام کلید نامعتبر: «$k»" ;; esac
        if [ "$k" = ports ]; then
          [ -n "$(key_spec "$side" ports)" ] || die 'سمت کلاینت کلید ports ندارد.'
          has_ports=1                   # «ports=» یعنی خالی کن
        else
          tv=$(toml_value "$side" "$k" "$v")
          pending="$pending$k	$tv
"
        fi
        ;;
      *) die "خط نامعتبر (شکل «کلید=مقدار»): «$line»" ;;
    esac
  done <"$conf.in.$$"
  rm -f "$conf.in.$$"

  [ -n "$pending" ] || [ "$has_ports" = 1 ] || die 'چیزی برای نوشتن نبود.'

  # ------- پاس دوم: نوشتن روی نسخه‌ی موقت
  tmp="$conf.new.$$"
  cp "$conf" "$tmp"
  chmod 600 "$tmp"
  printf '%s' "$pending" | while IFS='	' read -r k tv; do
    [ -n "$k" ] || continue
    old=$(sed -n "s/^[[:space:]]*$k[[:space:]]*=[[:space:]]*//p" "$tmp" |
            sed -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//' | head -n1)
    if [ "$old" = "$tv" ]; then printf 'unchanged %s\n' "$k"
    else printf 'changed %s\n' "$k"; fi
  done >"$conf.rep.$$"
  printf '%s' "$pending" | while IFS='	' read -r k tv; do
    [ -n "$k" ] || continue
    set_conf_val "$tmp" "$k" "$tv"
  done
  if [ "$has_ports" = 1 ]; then
    old_ports=$(sed -n '/^[[:space:]]*ports[[:space:]]*=[[:space:]]*\[/,/\]/p' "$tmp")
    if [ -z "$rows" ]; then set_conf_ports "$tmp"
    else
      saved_ifs=$IFS; IFS='
'; set -f
      # shellcheck disable=SC2086
      set -- $rows
      IFS=$saved_ifs; set +f
      set_conf_ports "$tmp" "$@"
    fi
    new_ports=$(sed -n '/^[[:space:]]*ports[[:space:]]*=[[:space:]]*\[/,/\]/p' "$tmp")
    if [ "$old_ports" = "$new_ports" ]; then printf 'unchanged ports\n' >>"$conf.rep.$$"
    else printf 'changed ports\n' >>"$conf.rep.$$"; fi
  fi

  # ------- جایگزینی اتمیک، با پشتیبان
  cp "$conf" "$conf.bak"
  chmod 600 "$conf.bak"
  mv "$tmp" "$conf"
  cat "$conf.rep.$$"
  rm -f "$conf.rep.$$"
}

port_busy() {
  command -v ss >/dev/null 2>&1 || return 1
  ss -lnt 2>/dev/null | awk 'NR>1{print $4}' | grep -qE "[:.]$1\$"
}

ufw_active() {
  command -v ufw >/dev/null 2>&1 || return 1
  ufw status 2>/dev/null | grep -q 'Status: active'
}

# رمز apr1 — با openssl، چون htpasswd روی نصب معمولی نیست (apache2-utils).
htpasswd_line() {                       # $1=کاربر  $2=رمز
  if command -v openssl >/dev/null 2>&1 &&
     h=$(openssl passwd -apr1 "$2" 2>/dev/null) && [ -n "$h" ]; then
    printf '%s:%s\n' "$1" "$h"
  elif command -v htpasswd >/dev/null 2>&1; then
    htpasswd -nbB "$1" "$2"
  else
    die 'نه openssl هست و نه htpasswd — رمز پنل ساخته نشد.'
  fi
}

gen_pass() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | cut -c1-18
  elif [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
    od -An -tx1 -N9 /dev/urandom | tr -d ' \n'
  else
    die 'راهی برای ساخت رمز تصادفی نبود — با --user و رمز دستی پیش بروید.'
  fi
}

# قاعده‌ی فایروال به‌صورت drop-in سرویس نوشته می‌شود، نه iptables دستی: این‌طور
# دقیقاً تا وقتی موتور گوش می‌دهد اعمال است، در هر boot از نو ساخته می‌شود (پس
# به iptables-save وابسته نیست) و فایل یونیت shipped دست‌نخورده می‌ماند.
fw_pair() {                             # $1=ابزار  $2=پورت  $3=loopback
  printf 'ExecStartPost=/bin/sh -c "%s -C INPUT ! -s %s -p tcp --dport %s -j DROP 2>/dev/null || %s -I INPUT ! -s %s -p tcp --dport %s -j DROP"\n' \
    "$1" "$3" "$2" "$1" "$3" "$2"
  printf 'ExecStopPost=-/bin/sh -c "%s -D INPUT ! -s %s -p tcp --dport %s -j DROP 2>/dev/null || true"\n' \
    "$1" "$3" "$2"
}

write_fw_dropin() {                     # $1=web_port
  cat <<EOF
# ساخته‌ی «farshub panel-up» — با «farshub panel-down» حذف می‌شود.
# پنل داخلی موتور اجرا روی همه‌ی اینترفیس‌ها گوش می‌دهد و احراز هویت ندارد؛
# آدرس bind قابل تنظیم نیست، پس تنها راه بستنش فایروال است. قاعده در هر boot
# دوباره اعمال می‌شود. اگر iptables خراب باشد سرویس بالا نمی‌آید — عمدی است:
# تونلِ خوابیده بهتر از پنلِ بی‌رمزِ باز روی اینترنت است.
[Service]
EOF
  fw_pair "$IPT" "$1" '127.0.0.1/32'
  [ -n "$IPT6" ] && fw_pair "$IPT6" "$1" '::1/128'
  return 0
}

write_site() {                          # $1=پورت پنل  $2=web_port
  cat <<EOF
# ساخته‌ی «farshub panel-up» — با «farshub panel-down» حذف می‌شود.
# دست‌نویسی نکنید؛ اجرای بعدی panel-up بازنویسی‌اش می‌کند.
server {
    listen $1;
EOF
  have_ipv6 && printf '    listen [::]:%s;\n' "$1"
  cat <<EOF
    server_name _;

    root $STATE_DIR/web;
    index index.html;

    # موتور اجرا هیچ احراز هویتی ندارد، پس لایه‌ی رمز اینجاست.
    # از خود ماشین (تونل SSH) بدون رمز باز می‌شود.
    auth_basic           "$BRAND";
    auth_basic_user_file $HTPASSWD_FILE;
    satisfy any;
    allow 127.0.0.1;
    allow ::1;
    deny  all;

    # فقط همین دو مسیر پروکسی می‌شوند؛ بقیه‌ی موتور — از جمله /debug/pprof —
    # عمداً بیرون می‌ماند. پنل هر ۲ ثانیه poll می‌کند، پس لاگ دسترسی خاموش است
    # وگرنه روزی ۸۰ هزار خط روی دیسک می‌نشیند.
    location = /stats {
        access_log off;
        proxy_pass http://127.0.0.1:$2/stats;
    }
    location = /data {
        access_log off;
        proxy_pass http://127.0.0.1:$2/data;
    }
    location = /peers.json {
        access_log off;
    }
}
EOF
}

# --------------------------------------------------------- تایمر peers --
# کارت همتاها در پنل، peers.json را هر ۲ ثانیه می‌خواند؛ این تایمر هر ۳۰
# ثانیه «farshub peers» را اجرا و خروجی را اتمیک از نو می‌نویسد (tmp + mv،
# به رسم state در cmd_peers — پنل هرگز فایلِ نیم‌نوشته نمی‌بیند). یونیت‌ها
# مثل drop-in فایروال درجا ساخته می‌شوند و در مخزن فایل ثابت ندارند، چون
# نامشان به UNIT_PREFIX بسته است. دستورهای _peers-install/_peers-uninstall
# داخلی‌اند: panel-up/down همین‌ها را صدا می‌زنند و تست، جدا از nginx و
# systemd واقعی، همین‌ها را می‌سنجد.

peers_service_unit() {                    # $1=سمت → متن یونیت سرویس روی stdout
  cat <<EOF
# ساخته‌ی «farshub panel-up» — با «farshub panel-down» حذف می‌شود.
[Unit]
Description=FarsHub Tunnel — peers JSON (سمت $1)
Documentation=https://github.com/saeedgh837/FarsHub-Tunnel

[Service]
Type=oneshot
Environment=FARSHUB_CONF_DIR=$CONF_DIR
Environment=FARSHUB_LIBEXEC=$LIBEXEC
Environment=FARSHUB_BIN_DIR=$BIN_DIR
Environment=FARSHUB_UNIT_DIR=$UNIT_DIR
Environment=FARSHUB_LOG_DIR=$LOG_DIR
Environment=FARSHUB_STATE_DIR=$STATE_DIR
Environment=FARSHUB_UNIT_PREFIX=$UNIT_PREFIX
ExecStart=/bin/sh -c '$BIN_DIR/farshub peers $1 > $STATE_DIR/web/peers.json.tmp && mv $STATE_DIR/web/peers.json.tmp $STATE_DIR/web/peers.json'
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=$STATE_DIR
EOF
}

peers_timer_unit() {
  cat <<EOF
# ساخته‌ی «farshub panel-up» — با «farshub panel-down» حذف می‌شود.
[Unit]
Description=FarsHub Tunnel — تایمر peers

[Timer]
OnBootSec=15
OnUnitActiveSec=30

[Install]
WantedBy=timers.target
EOF
}

cmd_peers_install() {                     # $1=سمت
  side=${1:-}
  case "$side" in server|s) side=server ;; client|c) side=client ;;
    *) die "سمت نامعتبر: «$side» (server یا client)" 2 ;; esac
  conf=$(side_conf "$side")
  [ -f "$conf" ] || die "کانفیگ نیست: $conf"
  need_write "$UNIT_DIR" "$STATE_DIR"

  t=$(mktemp) || die 'ساخت فایل موقت ناموفق بود.'
  peers_service_unit "$side" >"$t"
  install -m644 "$t" "$UNIT_DIR/$UNIT_PREFIX-peers.service"
  peers_timer_unit >"$t"
  install -m644 "$t" "$UNIT_DIR/$UNIT_PREFIX-peers.timer"
  rm -f "$t"
  say "  یونیت   → $UNIT_DIR/$UNIT_PREFIX-peers.service"
  say "  یونیت   → $UNIT_DIR/$UNIT_PREFIX-peers.timer"
  if have_systemd; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    if systemctl enable --now "$UNIT_PREFIX-peers.timer" >/dev/null 2>&1; then
      say '  تایمر   → فعال شد؛ هر ۳۰ ثانیه peers.json از نو ساخته می‌شود'
    else
      say '  تایمر   → فعال نشد (systemd بالا نیست؟) — یونیت‌ها نوشته شدند'
    fi
  else
    say '  تایمر   → systemd در دسترس نیست؛ فقط یونیت‌ها نوشته شدند'
  fi

  # پرایم: تا نخستین تیکِ تایمر (تا ۳۰ ثانیه) کارت همتاها خالی نماند. شکستش
  # خطا نیست — تایمر بعداً می‌سازد.
  mkdir -p "$STATE_DIR/web"
  out=$(cmd_peers "$side" 2>/dev/null) || out=''
  if [ -n "$out" ]; then
    printf '%s\n' "$out" >"$STATE_DIR/web/peers.json.tmp"
    mv "$STATE_DIR/web/peers.json.tmp" "$STATE_DIR/web/peers.json"
    say "  peers   → $STATE_DIR/web/peers.json ساخته شد"
  else
    say '  peers   → پرایم نشد؛ نخستین اجرای تایمر می‌سازدش'
  fi
}

cmd_peers_uninstall() {
  if have_systemd; then
    systemctl disable --now "$UNIT_PREFIX-peers.timer" 2>/dev/null || true
    systemctl stop "$UNIT_PREFIX-peers.service" 2>/dev/null || true
  fi
  rm -f "$UNIT_DIR/$UNIT_PREFIX-peers.service" "$UNIT_DIR/$UNIT_PREFIX-peers.timer"
  if have_systemd; then
    systemctl daemon-reload 2>/dev/null || true
  fi
  say '  تایمر   ← peers متوقف و یونیت‌هایش حذف شدند'
  # peers.json می‌رود تا پنلِ خاموش داده‌ی کهنه نشان ندهد؛ peers-state.json
  # می‌ماند — تاریخچه‌ی داخلی مشاهده است، نه فایل پنل.
  rm -f "$STATE_DIR/web/peers.json"
  say '  پنل     ← peers.json حذف شد (تا داده‌ی کهنه نشان ندهد)'
}

cmd_panel_up() {
  side=''; pport=8088; puser='farshub'; wport=''; sniff=0; newpw=0; ppass=''
  while [ $# -gt 0 ]; do
    case $1 in
      --port)         [ $# -ge 2 ] || die '--port مقدار می‌خواهد.'; pport=$2; shift ;;
      --port=*)       pport=${1#--port=} ;;
      --user)         [ $# -ge 2 ] || die '--user مقدار می‌خواهد.'; puser=$2; shift ;;
      --user=*)       puser=${1#--user=} ;;
      --web-port)     [ $# -ge 2 ] || die '--web-port مقدار می‌خواهد.'; wport=$2; shift ;;
      --web-port=*)   wport=${1#--web-port=} ;;
      --sniffer)      sniff=1 ;;
      --password)     [ $# -ge 2 ] || die '--password مقدار می‌خواهد.'; ppass=$2; shift ;;
      --password=*)   ppass=${1#--password=} ;;
      --new-password) newpw=1 ;;
      server|s)       side=server ;;
      client|c)       side=client ;;
      *)              die "گزینه‌ی ناشناس: $1" ;;
    esac
    shift
  done
  # رمز داخل خط htpasswd می‌نشیند؛ «:» جداکننده‌ی همان خط است. پیش از need_root
  # سنجیده می‌شود تا خطای تایپی با sudo هم دوباره تکرار نشود.
  case $ppass in
    *:*)   die 'رمز نمی‌تواند «:» داشته باشد (جداکننده‌ی خطِ htpasswd است).' ;;
    *"'"*) die "رمز نمی‌تواند «'» داشته باشد." ;;
  esac
  if [ -n "$ppass" ]; then
    [ ${#ppass} -ge 6 ] || die 'رمز کوتاه است — دست‌کم ۶ نویسه.'
    newpw=1                             # --password یعنی همین رمز، پس حفظ رمز قبلی معنا ندارد
  fi
  [ -n "$side" ] || side=$(guess_side panel-up)

  need_root
  have_systemd ||
    die 'panel-up به systemd نیاز دارد (قاعده‌ی فایروال روی سرویس سوار می‌شود).'
  conf=$(side_conf "$side")
  [ -f "$conf" ] || die "کانفیگ نیست: $conf — اول «farshub install $side»."
  [ -d "$STATE_DIR/web" ] ||
    die "پنل در $STATE_DIR/web نیست — «farshub install $side» را دوباره بزنید."
  case $pport in ''|*[!0-9]*) die "پورت پنل نامعتبر: «$pport»" ;; esac
  case $puser in ''|*[!A-Za-z0-9._-]*) die "نام کاربری نامعتبر: «$puser»" ;; esac

  # موتور اجرا آدرس bind پنل داخلی‌اش را قابل تنظیم نکرده و روی همه‌ی
  # اینترفیس‌ها گوش می‌دهد. بدون iptables راهی برای بستنش نیست.
  IPT=$(command -v iptables 2>/dev/null) || IPT=''
  [ -n "$IPT" ] || die 'iptables پیدا نشد؛ بدون آن پنلِ بی‌رمزِ موتور از بیرون باز می‌ماند. نصبش کنید و دوباره بزنید.'
  IPT6=''
  if have_ipv6; then IPT6=$(command -v ip6tables 2>/dev/null) || IPT6=''; fi

  # web_port: صریح > مقدار فعلی کانفیگ > 2060
  cur=$(conf_val "$conf" web_port) || cur=''
  if [ -z "$wport" ]; then
    if [ -n "$cur" ] && [ "$cur" != '0' ]; then wport=$cur; else wport=2060; fi
  fi
  case $wport in ''|*[!0-9]*) die "web_port نامعتبر: «$wport»" ;; esac
  [ "$wport" = "$pport" ] && die "پورت پنل و web_port نمی‌توانند یکی باشند ($pport)."

  # هنوز ممکن است nginx نصب نباشد؛ آن‌وقت هیچ‌کدام از دو ساختار نیست و
  # تشخیص واقعی بعد از ensure_nginx تکرار می‌شود.
  if [ -d /etc/nginx ]; then
    resolve_site_paths; site=$SITE_FILE; link=$SITE_LINK
  else
    site=''; link=''
  fi

  say "$BRAND — بالا آوردن پنل سمت $side"
  say ''

  ensure_nginx
  # مسیر nginx تازه نصب‌شده تا حالا وجود نداشت، پس بعد از نصب دوباره بسنج.
  if [ -z "$site" ]; then
    [ -d /etc/nginx ] ||
      die 'ساختار /etc/nginx شناسایی نشد (نه sites-available و نه conf.d).'
    resolve_site_paths; site=$SITE_FILE; link=$SITE_LINK
    [ -d "$(dirname -- "$site")" ] ||
      die 'ساختار /etc/nginx شناسایی نشد (نه sites-available و نه conf.d).'
  fi
  if [ ! -f "$site" ] && port_busy "$pport"; then
    die "پورت $pport اشغال است — با --port پورت دیگری بدهید."
  fi

  # ۱) موتور: پنل داخلی روشن شود تا چیزی برای پروکسی‌کردن باشد.
  set_conf_val "$conf" web_port "$wport"
  say "  موتور   → web_port=$wport"
  if [ "$sniff" = 1 ]; then
    set_conf_val "$conf" sniffer true
    say '  موتور   → sniffer=true (جدول پورت‌ها پر می‌شود؛ کمی CPU می‌گیرد)'
  fi

  # ۲) فایروال، پیش از restart تا پورت هرگز بی‌محافظ باز نشود.
  unit=$(side_unit "$side")
  install -d -m755 "$UNIT_DIR/$unit.d"
  write_fw_dropin "$wport" >"$UNIT_DIR/$unit.d/10-firewall.conf"
  chmod 644 "$UNIT_DIR/$unit.d/10-firewall.conf"
  systemctl daemon-reload
  systemctl restart "$unit"
  if [ -n "$IPT6" ]; then
    say "  فایروال → پورت $wport فقط از خود ماشین (IPv4+IPv6)"
  else
    say "  فایروال → پورت $wport فقط از خود ماشین (IPv4)"
  fi

  # ۳) رمز. اگر کاربر از قبل هست، رمزش حفظ می‌شود — چرخاندن بی‌خبرِ رمز
  # یعنی اجرای دوباره‌ی panel-up دسترسی کسی را قطع کند.
  pw=''
  if [ "$newpw" = 0 ] && [ -f "$HTPASSWD_FILE" ] &&
     grep -q "^$puser:" "$HTPASSWD_FILE"; then
    say "  رمز     → کاربر «$puser» از قبل بود، رمز قبلی حفظ شد"
  else
    if [ -n "$ppass" ]; then pw=$ppass; else pw=$(gen_pass); fi
    line=$(htpasswd_line "$puser" "$pw")
    if [ -f "$HTPASSWD_FILE" ]; then
      grep -v "^$puser:" "$HTPASSWD_FILE" >"$HTPASSWD_FILE.new" || true
      printf '%s\n' "$line" >>"$HTPASSWD_FILE.new"
      mv "$HTPASSWD_FILE.new" "$HTPASSWD_FILE"
    else
      printf '%s\n' "$line" >"$HTPASSWD_FILE"
    fi
    chmod 640 "$HTPASSWD_FILE"
    chgrp www-data "$HTPASSWD_FILE" 2>/dev/null ||
      chgrp nginx "$HTPASSWD_FILE" 2>/dev/null || chmod 644 "$HTPASSWD_FILE"
    say "  رمز     → $HTPASSWD_FILE"
    # عوض کردن --user کاربر قبلی را حذف نمی‌کند و او همچنان می‌تواند وارد شود.
    # کسی که فکر می‌کند «کاربر را عوض کردم» باید این را بداند.
    others=$(cut -d: -f1 "$HTPASSWD_FILE" | grep -v "^$puser\$" | tr '\n' ' ')
    [ -n "$others" ] &&
      say "  رمز     → کاربر(های) قبلی هم هنوز دسترسی دارند: $others"
  fi

  # ۴) nginx. اگر کانفیگ پذیرفته نشد، برمی‌گردانیم — نه اینکه nginx زنده را بشکنیم.
  had_site=0; [ -f "$site" ] && had_site=1
  if [ "$had_site" = 1 ]; then cp "$site" "$site.bak"; fi
  write_site "$pport" "$wport" >"$site"
  [ -n "$link" ] && ln -sf "$site" "$link"
  if ! nginx -t >/dev/null 2>&1; then
    nginx -t 2>&1 | sed 's/^/    /'
    if [ "$had_site" = 1 ]; then mv "$site.bak" "$site"; else
      rm -f "$site"; [ -n "$link" ] && rm -f "$link"; fi
    die 'nginx کانفیگ را نپذیرفت — به حالت قبل برگشت.'
  fi
  rm -f "$site.bak"
  systemctl enable nginx >/dev/null 2>&1 || true
  if ! systemctl reload nginx >/dev/null 2>&1; then
    if ! systemctl restart nginx >/dev/null 2>&1; then
      systemctl status nginx --no-pager 2>&1 | sed -n '1,12p' | sed 's/^/    /'
      die 'nginx بالا نیامد — احتمالاً یکی از سایت‌هایش با سرویس دیگری روی همان پورت تعارض دارد.'
    fi
  fi
  say "  nginx   → $site"

  if ufw_active; then
    ufw allow "$pport/tcp" >/dev/null 2>&1 && say "  ufw     → پورت $pport باز شد"
  fi

  # ۵) panel.json تا نقش «نامعلوم» نشود (web_port عوض شده، پس از نو ساخته شود).
  panel_json "$side" >"$STATE_DIR/web/panel.json"
  chmod 644 "$STATE_DIR/web/panel.json"

  printf 'side=%s\npanel_port=%s\nweb_port=%s\nsite=%s\nlink=%s\n' \
    "$side" "$pport" "$wport" "$site" "$link" >"$PANEL_STATE"
  chmod 600 "$PANEL_STATE"

  # ۶) تایمر peers تا کارت همتاها زنده بماند؛ نخستین اجرا هم همین‌جا پرایم
  # می‌شود.
  cmd_peers_install "$side"

  ip=$(host_ip); [ -n "$ip" ] || ip='SERVER_IP'
  say ''
  say 'پنل بالا آمد.'
  say ''
  say "  آدرس   : http://$ip:$pport/"
  say "  کاربر  : $puser"
  if [ -n "$pw" ]; then
    say "  رمز    : $pw"
    say ''
    say 'رمز جای دیگری ذخیره نشده (فقط hash روی دیسک است) — همین حالا نگهش دارید.'
    say 'عوض کردنش:  farshub panel-up --password رمزتان'
  fi
  say ''
  say '⚠ ارتباط HTTP است، پس رمز رمزنگاری‌نشده رد می‌شود. برای دسترسی امن‌تر'
  say '  یا TLS بگذارید یا از تونل SSH استفاده کنید:'
  say "    ssh -N -L $pport:127.0.0.1:$pport root@$ip"
  if [ "$sniff" = 0 ] && [ "$(conf_val "$conf" sniffer)" != 'true' ]; then
    say ''
    say '  جدول پورت‌ها خالی می‌ماند: sniffer خاموش است.'
    say '  برای پر شدنش: farshub panel-up --sniffer'
  fi
  if grep -q '^[[:space:]]*token[[:space:]]*=[[:space:]]*"CHANGE_ME"' "$conf"; then
    say ''
    say '  ⚠ توکن هنوز CHANGE_ME است — تونل وصل نمی‌شود. «farshub token» و بعد edit.'
  fi
  say ''
  say "برگرداندن همه‌ی این تغییرات: farshub panel-down"
  if [ "$NGINX_FRESH" = 1 ]; then
    say 'خودِ nginx را panel-down حذف نمی‌کند؛ فقط سایت پنل را برمی‌دارد.'
  fi
}

cmd_panel_down() {
  need_root
  p_side=''; p_port=''; p_web=''; p_site=''; p_link=''
  if [ -f "$PANEL_STATE" ]; then
    # shellcheck source=/dev/null
    . "$PANEL_STATE"
    p_side=${side:-}; p_port=${panel_port:-}; p_web=${web_port:-}
    p_site=${site:-}; p_link=${link:-}
  fi
  [ -n "$p_side" ] || p_side=${1:-}
  [ -n "$p_side" ] || p_side=$(guess_side panel-down)
  case "$p_side" in server|s) p_side=server ;; client|c) p_side=client ;;
    *) die "سمت نامعتبر: «$p_side»" ;; esac

  say "$BRAND — خواباندن پنل سمت $p_side"
  say ''

  # nginx اول: تا پنل جواب می‌دهد، کسی وسط کار قطعی نبیند.
  for f in "$p_site" "/etc/nginx/sites-available/$SITE_NAME" \
           "/etc/nginx/conf.d/$SITE_NAME.conf"; do
    [ -n "$f" ] && [ -f "$f" ] && { rm -f "$f"; say "  nginx   ← $f حذف شد"; }
  done
  for f in "$p_link" "/etc/nginx/sites-enabled/$SITE_NAME"; do
    [ -n "$f" ] && [ -L "$f" ] && rm -f "$f"
  done
  if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
    systemctl reload nginx >/dev/null 2>&1 || true
  fi
  if [ -f "$HTPASSWD_FILE" ]; then rm -f "$HTPASSWD_FILE"; say '  رمز     ← حذف شد'; fi

  unit=$(side_unit "$p_side")
  dropin="$UNIT_DIR/$unit.d/10-firewall.conf"
  conf=$(side_conf "$p_side")
  was=$(systemctl is-active "$unit" 2>/dev/null) || was=''

  # stop پیش از حذف drop-in، وگرنه ExecStopPost اجرا نمی‌شود و قاعده
  # تا reboot در iptables می‌ماند.
  if have_systemd && [ -f "$dropin" ]; then
    systemctl stop "$unit" >/dev/null 2>&1 || true
    rm -f "$dropin"
    rmdir "$UNIT_DIR/$unit.d" 2>/dev/null || true
    systemctl daemon-reload
    say '  فایروال ← قاعده و drop-in حذف شد'
  fi

  # تایمر peers هم مالِ همین پنل است: می‌ایستد و peers.json می‌رود. تاریخچه‌ی
  # state می‌ماند — داخلی است، نه فایل پنل.
  cmd_peers_uninstall

  if [ -f "$conf" ]; then
    set_conf_val "$conf" web_port 0
    say '  موتور   ← web_port=0'
  fi

  if have_systemd && [ "$was" = 'active' ]; then
    systemctl start "$unit"
    say '  سرویس   ← دوباره بالا آمد'
  fi

  if [ -n "$p_port" ] && ufw_active; then
    ufw delete allow "$p_port/tcp" >/dev/null 2>&1 || true
  fi

  rm -f "$PANEL_STATE"
  say ''
  say 'پنل خوابید: تایمر peers متوقف و peers.json حذف شد.'
  say 'فایل‌های پنل و panel.json سر جایشان ماندند؛'
  say 'با «farshub panel-up» دوباره بالا می‌آید.'
}

# «این نصب کجاست؟» — همان سؤالی که در پشتیبانی مرتب پرسیده می‌شود، و تنها
# راه دیدن اثر FARSHUB_* بدون root و بدون systemd.
cmd_paths() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side_soft)
  [ -n "$side" ] || side=server
  case "$side" in server|s) side=server ;; client|c) side=client ;;
    *) die "سمت نامعتبر: «$side»" ;; esac
  resolve_site_paths
  unit=$(side_unit "$side")
  printf 'side=%s\n'        "$side"
  printf 'conf=%s\n'        "$(side_conf "$side")"
  printf 'unit=%s\n'        "$unit"
  printf 'unit_file=%s\n'   "$UNIT_DIR/$unit"
  printf 'dropin_dir=%s\n'  "$UNIT_DIR/$unit.d"
  printf 'site_name=%s\n'   "$SITE_NAME"
  printf 'site=%s\n'        "$SITE_FILE"
  printf 'site_link=%s\n'   "$SITE_LINK"
  printf 'htpasswd=%s\n'    "$HTPASSWD_FILE"
  printf 'panel_state=%s\n' "$PANEL_STATE"
  printf 'api_state=%s\n'   "$API_STATE"
  printf 'web=%s\n'         "$STATE_DIR/web"
  printf 'payload=%s\n'     "$PAYLOAD_DIR"
  printf 'libexec=%s\n'     "$LIBEXEC"
  printf 'log=%s\n'         "$LOG_DIR"
  printf 'bin=%s\n'         "$BIN_DIR"
  # پنل باید بتواند «هنوز نصب نشده» را بدون root تشخیص بدهد — ویزارد سرور
  # خام روی همین سیگنال سوار است.
  [ -f "$CONF_DIR/server.toml" ] && printf 'installed_server=1\n' || printf 'installed_server=0\n'
  [ -f "$CONF_DIR/client.toml" ] && printf 'installed_client=1\n' || printf 'installed_client=0\n'
}

# panel.json را روی stdout می‌سازد تا بتوان جایی که پنل سرو می‌شود ریدایرکتش کرد.
cmd_panel_meta() {
  side=${1:-}
  [ -n "$side" ] || side=$(guess_side panel-meta)
  case "$side" in server|s) side=server ;; client|c) side=client ;;
    *) die "سمت نامعتبر: «$side»" ;; esac
  panel_json "$side"
}

# ---------------------------------------------------------------- dispatch --
[ $# -gt 0 ] || { cmd_help; exit 0; }
cmd=$1; shift

case "$cmd" in
  install)                 cmd_install "$@" ;;
  run)                     cmd_run "$@" ;;
  _exec)                   cmd_exec "$@" ;;   # داخلی — یونیت systemd
  start|stop|restart|enable|disable) svc "$cmd" "$@" ;;
  status)                  cmd_status "$@" ;;
  logs|log)                cmd_logs "$@" ;;
  config|conf)             cmd_config "$@" ;;
  apply-config|apply_config) cmd_apply_config "$@" ;;
  edit)                    cmd_edit "$@" ;;
  token)                   cmd_token ;;
  check|doctor)            cmd_check "$@" ;;
  peers)                   cmd_peers "$@" ;;
  panel)                   cmd_panel "$@" ;;
  panel-up|panel_up)       cmd_panel_up "$@" ;;
  panel-down|panel_down)   cmd_panel_down "$@" ;;
  _peers-install)          cmd_peers_install "$@" ;;   # داخلی — برای panel-up و تست
  _peers-uninstall)        cmd_peers_uninstall "$@" ;; # داخلی — برای panel-up و تست
  panel-meta|panel_meta)   cmd_panel_meta "$@" ;;
  paths)                   cmd_paths "$@" ;;
  version|-v|--version)    cmd_version ;;
  support)                 cmd_support ;;
  help|-h|--help)          cmd_help ;;
  # هر چیز دیگر: مستقیم به موتور اجرا، با فیلتر برندینگ.
  *)
    core=$(find_core)
    "$core" "$cmd" "$@" 2>&1 | brand_filter
    ;;
esac
